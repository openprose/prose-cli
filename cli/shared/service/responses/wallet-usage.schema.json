{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v1/service/responses/wallet-usage.schema.json",
  "title": "service response acceptance: GET /wallet/usage",
  "x-probed": true,
  "type": "object",
  "required": [
    "period",
    "total_runs",
    "total_input_tokens",
    "total_output_tokens",
    "total_price_cents",
    "daily"
  ],
  "properties": {
    "period": {
      "type": "object",
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "total_runs": {
      "type": "integer"
    },
    "total_input_tokens": {
      "type": "integer"
    },
    "total_output_tokens": {
      "type": "integer"
    },
    "total_price_cents": {
      "type": "integer"
    },
    "daily": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date",
          "runs",
          "input_tokens",
          "output_tokens",
          "price_cents"
        ],
        "properties": {
          "date": {
            "type": "string"
          },
          "runs": {
            "type": "integer"
          },
          "input_tokens": {
            "type": "integer"
          },
          "output_tokens": {
            "type": "integer"
          },
          "price_cents": {
            "type": "integer"
          }
        }
      }
    }
  }
}
