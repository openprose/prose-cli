{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v1/service/common.schema.json",
  "title": "OpenProse service shared result definitions",
  "$defs": {
    "runId": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]{1,128}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "session": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "revId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "commitId": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "handle": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "programRef": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9-]{0,38}/[a-z0-9][a-z0-9-]{0,63}@[0-9a-f]{16}$"
    },
    "modelId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$"
    },
    "timestamp": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "epochMs": {
      "type": "integer",
      "minimum": 0
    },
    "cents": {
      "type": "integer"
    },
    "dollars": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "usd": {
      "type": "string",
      "pattern": "^-?[0-9]+\\.[0-9]{2}$"
    },
    "line": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "shortLine": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "text": {
      "type": "string",
      "maxLength": 1048576,
      "pattern": "^[^\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f\\u007f]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$))[^\\u0000-\\u001f\\u007f\\\\]+$"
    },
    "environmentProvenance": {
      "description": "The public id of the environment the run used (`builtin` or `linux`).",
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "owner",
        "name"
      ],
      "properties": {
        "provider": {
          "const": "github"
        },
        "owner": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "name": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "ref": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "writable": {
          "type": "boolean"
        }
      }
    },
    "commitOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "provider",
        "repository",
        "branch",
        "source_commit_sha",
        "commit_sha",
        "changed_files",
        "url"
      ],
      "properties": {
        "type": {
          "const": "commit"
        },
        "provider": {
          "const": "github"
        },
        "repository": {
          "type": "string",
          "maxLength": 200,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "branch": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "source_commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "changed_files": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "maxItems": 10000
        },
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/[^\\s]+$",
          "maxLength": 512
        }
      }
    },
    "writtenFile": {
      "description": "Downloaded bytes. `content` is present only when no --output-file was given and the bytes are UTF-8 text; local paths are never reported.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bytes",
        "sha256",
        "written"
      ],
      "properties": {
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "written": {
          "type": "boolean"
        },
        "content": {
          "$ref": "common.schema.json#/$defs/text"
        },
        "contentType": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        }
      }
    },
    "balance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_cents",
        "available_dollars",
        "posted_cents",
        "posted_dollars",
        "reserved_cents",
        "reserved_dollars"
      ],
      "properties": {
        "available_cents": {
          "type": "integer"
        },
        "available_dollars": {
          "$ref": "common.schema.json#/$defs/dollars"
        },
        "posted_cents": {
          "type": "integer"
        },
        "posted_dollars": {
          "$ref": "common.schema.json#/$defs/dollars"
        },
        "reserved_cents": {
          "type": "integer"
        },
        "reserved_dollars": {
          "$ref": "common.schema.json#/$defs/dollars"
        }
      }
    },
    "holdQuote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hold_usd",
        "hold_cents",
        "ttl_seconds"
      ],
      "properties": {
        "hold_usd": {
          "$ref": "common.schema.json#/$defs/usd"
        },
        "hold_cents": {
          "description": "hold_usd in whole cents.",
          "type": "integer"
        },
        "ttl_seconds": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
