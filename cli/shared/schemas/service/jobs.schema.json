{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v1/service/jobs.schema.json",
  "title": "OpenProse service job results",
  "description": "Closed per-operation result projections. Referenced from shared/service/operations.v1.json by $defs name; no property name may match /cost/i.",
  "$defs": {
    "jobContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "program_ref"
      ],
      "properties": {
        "program_ref": {
          "$ref": "common.schema.json#/$defs/programRef"
        },
        "program_slug": {
          "$ref": "common.schema.json#/$defs/slug"
        },
        "enabled": {
          "type": "boolean"
        },
        "model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/modelId"
            }
          ]
        },
        "context_repository_full_name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "context_repository_branch": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "run_configuration": {
          "$ref": "#/$defs/runConfiguration"
        }
      }
    },
    "job": {
      "description": "A job's public fields, in snake_case. Any other service field (internal references, adoption and driver detail, repository detail objects) is dropped.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "created_at"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "type": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/epochMs"
        },
        "created_at_iso": {
          "description": "`created_at` as an RFC 3339 UTC time (null when `created_at` is null).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          ]
        },
        "name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "url": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 2048,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "interval_seconds": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "mode": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "repository_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "repository_full_name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "repository_branch": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "context_repository_full_name": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 200,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "context_repository_branch": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 256,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jobContract"
          },
          "maxItems": 16
        },
        "program_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/programRef"
            }
          ]
        },
        "program_slug": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/slug"
            }
          ]
        },
        "model": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/modelId"
            }
          ]
        },
        "last_run_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/runId"
            }
          ]
        },
        "last_error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "next_fire_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/epochMs"
            }
          ]
        },
        "next_fire_at_iso": {
          "description": "`next_fire_at` as an RFC 3339 UTC time (null when `next_fire_at` is null).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          ]
        },
        "last_event_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/epochMs"
            }
          ]
        },
        "last_event_at_iso": {
          "description": "`last_event_at` as an RFC 3339 UTC time (null when `last_event_at` is null).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          ]
        }
      }
    },
    "jobStatus": {
      "description": "Job delivery status. Receiver, reply and inbound endpoint details are dropped. Schedule jobs add the cadence, the optimistic-concurrency pair (`configuration_revision` and the opaque `revision_token`) and each contract's run configuration, which `job configure` sends back under the same names.",
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "configured": {
          "type": "boolean"
        },
        "active": {
          "type": "boolean"
        },
        "delivery_mode": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "receiver_secret_configured": {
          "type": "boolean"
        },
        "reply_secret_configured": {
          "type": "boolean"
        },
        "secret_rotated_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/epochMs"
            }
          ]
        },
        "secret_rotated_at_iso": {
          "description": "`secret_rotated_at` as an RFC 3339 UTC time (null when `secret_rotated_at` is null).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          ]
        },
        "last_event_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/epochMs"
            }
          ]
        },
        "last_event_at_iso": {
          "description": "`last_event_at` as an RFC 3339 UTC time (null when `last_event_at` is null).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          ]
        },
        "last_run_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/runId"
            }
          ]
        },
        "last_error": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 1024,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "counts": {
          "description": "The job's runs by public state. The service's queue states fold into these; any other state is dropped.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "queued",
            "running",
            "completed",
            "failed",
            "cancelled",
            "awaiting_billing"
          ],
          "properties": {
            "queued": {
              "type": "integer",
              "minimum": 0,
              "description": "Waiting to start."
            },
            "running": {
              "type": "integer",
              "minimum": 0,
              "description": "Started and not finished."
            },
            "completed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "description": "Finished without completing, including runs whose outcome is unknown."
            },
            "cancelled": {
              "type": "integer",
              "minimum": 0
            },
            "awaiting_billing": {
              "type": "integer",
              "minimum": 0,
              "description": "Finished, with billing settlement still pending."
            }
          }
        },
        "interval_seconds": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer"
            }
          ]
        },
        "configuration_revision": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ]
        },
        "next_fire_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/epochMs"
            }
          ]
        },
        "next_fire_at_iso": {
          "description": "`next_fire_at` as an RFC 3339 UTC time (null when `next_fire_at` is null).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          ]
        },
        "last_fired_at": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/epochMs"
            }
          ]
        },
        "last_fired_at_iso": {
          "description": "`last_fired_at` as an RFC 3339 UTC time (null when `last_fired_at` is null).",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          ]
        },
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jobContract"
          },
          "maxItems": 16
        },
        "revision_token": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          ],
          "description": "Opaque revision token: send it back unchanged as `revision_token` with `job configure`."
        }
      }
    },
    "jobType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "config_fields"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "label": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "description": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "config_fields": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
          },
          "maxItems": 64
        }
      }
    },
    "jobList": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobs",
        "max_jobs",
        "job_limit",
        "types"
      ],
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/job"
          },
          "maxItems": 1000
        },
        "max_jobs": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "job_limit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            },
            "limit": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "types": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jobType"
          },
          "maxItems": 64
        }
      }
    },
    "jobShow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job"
      ],
      "properties": {
        "job": {
          "$ref": "#/$defs/job"
        },
        "status": {
          "$ref": "#/$defs/jobStatus"
        },
        "endpoint_url": {
          "description": "A webhook's absolute inbound URL, present only when the service's endpoint is the job's own webhook path (no secret in it).",
          "type": "string",
          "maxLength": 1024,
          "pattern": "^https://[^\\u0000-\\u0020\\u007f]*$"
        }
      }
    },
    "jobCreate": {
      "description": "`endpoint` and `signing_secret` appear only in this result; they are never repeated.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job"
      ],
      "properties": {
        "job": {
          "$ref": "#/$defs/job"
        },
        "status": {
          "$ref": "#/$defs/jobStatus"
        },
        "endpoint": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "signing_secret": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "endpoint_url": {
          "description": "The absolute inbound URL (the environment origin + `endpoint`).",
          "type": "string",
          "maxLength": 1024,
          "pattern": "^https://[^\\u0000-\\u0020\\u007f]*$"
        }
      }
    },
    "jobUpdate": {
      "description": "Provisional: update responses were not probed on the hosted service.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job"
      ],
      "properties": {
        "job": {
          "$ref": "#/$defs/job"
        },
        "status": {
          "$ref": "#/$defs/jobStatus"
        },
        "endpoint_url": {
          "description": "A webhook's absolute inbound URL, present only when the service's endpoint is the job's own webhook path (no secret in it).",
          "type": "string",
          "maxLength": 1024,
          "pattern": "^https://[^\\u0000-\\u0020\\u007f]*$"
        }
      }
    },
    "jobDelete": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "deleted"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "deleted": {
          "const": true
        },
        "already_absent": {
          "description": "Present (true) when the confirmed DELETE answered 404: the resource was already gone, so the goal state holds and the command exits 0.",
          "const": true
        }
      }
    },
    "jobDeliveries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deliveries"
      ],
      "properties": {
        "deliveries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "received_at",
              "outcome",
              "test_only"
            ],
            "properties": {
              "id": {
                "type": "integer"
              },
              "received_at": {
                "$ref": "common.schema.json#/$defs/epochMs"
              },
              "received_at_iso": {
                "description": "`received_at` as an RFC 3339 UTC time (null when `received_at` is null).",
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "common.schema.json#/$defs/timestamp"
                  }
                ]
              },
              "outcome": {
                "type": "string",
                "maxLength": 32,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              "test_only": {
                "type": "boolean"
              },
              "delivery_id": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                  }
                ]
              },
              "reason": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 1024,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                  }
                ]
              },
              "runs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "program_ref",
                    "status",
                    "run_id"
                  ],
                  "properties": {
                    "program_ref": {
                      "$ref": "common.schema.json#/$defs/programRef"
                    },
                    "status": {
                      "type": "string",
                      "maxLength": 32,
                      "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                    },
                    "run_id": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "$ref": "common.schema.json#/$defs/runId"
                        }
                      ]
                    }
                  }
                },
                "maxItems": 32,
                "description": "The runs the delivery started."
              }
            }
          },
          "maxItems": 100
        }
      }
    },
    "jobRotateSecret": {
      "description": "The new signing secret appears only in this result.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "endpoint",
        "signing_secret"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/uuid"
        },
        "endpoint": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "signing_secret": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "endpoint_url": {
          "description": "The absolute inbound URL (the environment origin + `endpoint`).",
          "type": "string",
          "maxLength": 1024,
          "pattern": "^https://[^\\u0000-\\u0020\\u007f]*$"
        }
      }
    },
    "jobContracts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts"
      ],
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/jobContract"
          },
          "maxItems": 16
        },
        "max_contracts": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "runConfiguration": {
      "description": "A schedule contract's run configuration, as `job configure` takes it back. Inputs whose names match /cost/i cannot be result property names (money rule), so they are listed losslessly in `input_entries` as {name, value}; merge them back into `inputs` before `job configure`, which replaces every input.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": {
          "$ref": "common.schema.json#/$defs/modelId"
        },
        "environment": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "reasoning_effort": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "inputs": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "not": {
              "pattern": "[Cc][Oo][Ss][Tt]"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "input_entries": {
          "description": "Configured inputs whose names match /cost/i, as {name, value} entries ordered by UTF-8 bytes of the name; absent when there are none.",
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "files": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "content",
              "size"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 256,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              "content": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "context_repositories": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "url"
            ],
            "properties": {
              "url": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              "branch": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                  }
                ]
              }
            }
          }
        },
        "output": {
