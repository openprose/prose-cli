{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v1/service/wallet.schema.json",
  "title": "OpenProse service wallet results",
  "description": "Closed per-operation result projections. Referenced from shared/service/operations.v1.json by $defs name; no property name may match /cost/i.",
  "$defs": {
    "walletBalance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "balance"
      ],
      "properties": {
        "balance": {
          "$ref": "common.schema.json#/$defs/balance"
        }
      }
    },
    "walletEvents": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "type",
              "occurred_at",
              "description",
              "amount_cents",
              "balance_after_cents"
            ],
            "properties": {
              "id": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              "type": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              "occurred_at": {
                "$ref": "common.schema.json#/$defs/timestamp"
              },
              "description": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
              },
              "amount_cents": {
                "type": "integer"
              },
              "balance_after_cents": {
                "type": "integer"
              },
              "ref": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 256,
                    "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
                  }
                ]
              }
            }
          },
          "maxItems": 100
        },
        "note": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "nextBefore": {
          "description": "Opaque cursor for the next page, or null on the last page. Pass it unchanged to `--before`; its content is not part of the contract and may change without notice.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "maxLength": 512,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        }
      }
    },
    "walletUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period",
        "total_runs",
        "total_input_tokens",
        "total_output_tokens",
        "total_price_cents",
        "daily"
      ],
      "properties": {
        "period": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "end"
          ],
          "properties": {
            "start": {
              "$ref": "common.schema.json#/$defs/date"
            },
            "end": {
              "$ref": "common.schema.json#/$defs/date"
            }
          }
        },
        "total_runs": {
          "type": "integer",
          "minimum": 0
        },
        "total_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_price_cents": {
          "type": "integer"
        },
        "daily": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "date",
              "runs",
              "input_tokens",
              "output_tokens",
              "price_cents"
            ],
            "properties": {
              "date": {
                "$ref": "common.schema.json#/$defs/date"
              },
              "runs": {
                "type": "integer",
                "minimum": 0
              },
              "input_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 0
              },
              "price_cents": {
                "type": "integer"
              }
            }
          },
          "maxItems": 400
        }
      }
    },
    "walletRedeem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "amount_usd"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "amount_usd": {
          "type": "number"
        },
        "already_redeemed": {
          "type": "boolean"
        },
        "credit_pending": {
          "type": "boolean"
        },
        "available_usd": {
          "type": "number"
        },
        "message": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        }
      }
    },
    "walletTopup": {
      "description": "The Checkout URL appears only in this result; the CLI never opens a browser.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkout_url",
        "session_id",
        "amount",
        "idempotencyKey"
      ],
      "properties": {
        "checkout_url": {
          "type": "string",
          "maxLength": 4096,
          "pattern": "^https://[^\\s]+$"
        },
        "session_id": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "amount": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "credits_cents",
            "fee_cents",
            "total_cents"
          ],
          "properties": {
            "credits_cents": {
              "type": "integer",
              "minimum": 0
            },
            "fee_cents": {
              "type": "integer",
              "minimum": 0
            },
            "total_cents": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "idempotencyKey": {
          "$ref": "common.schema.json#/$defs/uuid"
        }
      }
    }
  }
}
