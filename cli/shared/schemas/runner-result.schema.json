{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v1/runner-result.schema.json",
  "title": "OpenProse normalized runner result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "invocationId",
    "runner",
    "adapter",
    "transport",
    "negotiatedCapabilities",
    "languageImage",
    "digests",
    "cwd",
    "timing",
    "terminal",
    "semantic",
    "usage",
    "billing",
    "diagnosticRefs",
    "runnerExitCode"
  ],
  "properties": {
    "codexCompatibility": {
      "$ref": "codex-compatibility.schema.json"
    },
    "usageObservation": {
      "$ref": "sdk-observation.schema.json#/$defs/usageObservation"
    },
    "modelIdentity": {
      "$ref": "sdk-observation.schema.json#/$defs/modelIdentity"
    },
    "nativeLimits": {
      "$ref": "native-limits.schema.json"
    },
    "nativeOutputLimits": {
      "$ref": "native-output-limits.schema.json"
    },
    "nativeConfiguration": {
      "$ref": "native-configuration.schema.json"
    },
    "schema": {
      "const": "openprose.runner-result/1"
    },
    "invocationId": {
      "$ref": "common.schema.json#/$defs/nonEmptyString",
      "x-openprose-volatile": true
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "commit"
      ],
      "properties": {
        "name": {
          "enum": [
            "rust",
            "bun"
          ]
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "harnessVersion",
        "descriptorDigestSha256"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "harnessVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "descriptorDigestSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "transport": {
      "type": "string",
      "minLength": 1
    },
    "negotiatedCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promptPlacement",
        "isolation",
        "streaming",
        "cancellation",
        "terminal"
      ],
      "properties": {
        "promptPlacement": {
          "type": "string",
          "minLength": 1
        },
        "isolation": {
          "type": "string",
          "minLength": 1
        },
        "streaming": {
          "type": "string",
          "minLength": 1
        },
        "cancellation": {
          "type": "string",
          "minLength": 1
        },
        "terminal": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "languageImage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formatVersion",
        "version",
        "sha256"
      ],
      "properties": {
        "formatVersion": {
          "const": "openprose.skill-runtime-image/1"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invocationSha256",
        "taskSha256",
        "normalizedEventsSha256"
      ],
      "properties": {
        "invocationSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "taskSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "normalizedEventsSha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        },
        "deliveredImageSha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "renderedPayloadSha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cwd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "identitySha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "identitySha256": {
          "$ref": "common.schema.json#/$defs/sha256"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAt",
        "firstEventAt",
        "cancellationAt",
        "terminalAt",
        "durationMs"
      ],
      "properties": {
        "startedAt": {
          "$ref": "common.schema.json#/$defs/rfc3339",
          "x-openprose-volatile": true
        },
        "firstEventAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/rfc3339"
            },
            {
              "type": "null"
            }
          ],
          "x-openprose-volatile": true
        },
        "cancellationAt": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/rfc3339"
            },
            {
              "type": "null"
            }
          ],
          "x-openprose-volatile": true
        },
        "terminalAt": {
          "$ref": "common.schema.json#/$defs/rfc3339",
          "x-openprose-volatile": true
        },
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "x-openprose-volatile": true
        }
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "transportCompleted",
        "terminalEventObserved",
        "exitCode",
        "signal"
      ],
      "properties": {
        "classification": {
          "enum": [
            "success",
            "semantic-failed",
            "cancelled",
            "terminated",
            "timeout",
            "killed",
            "exit-code",
            "runner-error"
          ]
        },
        "transportCompleted": {
          "type": "boolean"
        },
        "terminalEventObserved": {
          "type": "boolean"
        },
        "exitCode": {
          "type": [
            "integer",
            "null"
          ]
        },
        "signal": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "terminalSchemaSha256",
        "terminalEnvelopeDigestSha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "success",
            "semantic-failed",
            "unknown",
            "not-applicable"
          ]
        },
        "terminalSchemaSha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminalEnvelopeDigestSha256": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "usage": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "const": "unavailable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "inputTokens",
            "outputTokens",
            "cost",
            "currency"
          ],
          "properties": {
            "status": {
              "const": "authoritative"
            },
            "inputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "outputTokens": {
              "type": "integer",
              "minimum": 0
            },
            "cost": {
              "type": "number",
              "minimum": 0
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            }
          }
        }
      ]
    },
    "billing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "authCategory"
      ],
      "properties": {
        "owner": {
          "$ref": "common.schema.json#/$defs/billingOwner"
        },
        "authCategory": {
          "$ref": "common.schema.json#/$defs/authCategory"
        }
      }
    },
    "diagnosticRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runnerExitCode": {
      "type": "integer",
      "enum": [
        0,
        2,
        10,
        20,
        21,
        22,
        23,
        24,
        25,
        30,
        70
      ]
    },
    "error": {
      "$ref": "runner-error.schema.json"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "semantic": {
            "properties": {
              "status": {
                "const": "success"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "terminal": {
            "properties": {
              "classification": {
                "const": "success"
              }
            }
          },
          "runnerExitCode": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "semantic": {
            "properties": {
              "status": {
                "const": "semantic-failed"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "terminal": {
            "properties": {
              "classification": {
                "const": "semantic-failed"
              }
            }
          },
          "runnerExitCode": {
            "const": 30
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "semantic": {
            "properties": {
              "status": {
                "const": "not-applicable"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "terminal": {
            "properties": {
              "classification": {
                "const": "success"
              }
            }
          },
          "runnerExitCode": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runnerExitCode": {
            "enum": [
              2,
              10,
              20,
              21,
              22,
              23,
              24,
              25,
              70
            ]
          }
        }
      },
      "then": {
        "required": [
          "error"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "runnerExitCode": {
            "enum": [
              0,
              30
            ]
          }
        }
      },
      "then": {
        "not": {
          "required": [
            "error"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "adapter": {
            "properties": {
              "id": {
                "const": "agents-sdk/jsonl"
              }
            },
            "required": [
              "id"
            ]
          }
        },
        "required": [
          "adapter"
        ]
      },
      "then": {
        "properties": {
          "usage": {
            "properties": {
              "status": {
                "const": "unavailable"
              }
            }
          }
        }
      }
    }
  ]
}
