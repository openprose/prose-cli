{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v1/doctor-report.schema.json",
  "title": "OpenProse runner doctor report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runner", "build", "ready", "cwd", "selectedHarness", "selectedHarnessVersion", "selectedTransport", "selectedAdapterId", "promptPlacement", "isolation", "authCategory", "selectedAuthReadiness", "billingOwner", "image", "configuration", "harnesses", "problems"],
  "properties": {
    "codexCompatibility": { "$ref": "codex-compatibility.schema.json" },
    "schema": { "const": "openprose.doctor-report/1" },
    "imageSource": { "const": "published-on-run", "description": "Kernel is resolved on language execution; image describes only the embedded local diagnostic fixture." },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "commit"],
      "properties": {
        "name": { "enum": ["rust", "bun"] },
        "version": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "minLength": 1 }
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "testSeamsEnabled"],
      "properties": {
        "profile": { "enum": ["development", "release"] },
        "testSeamsEnabled": { "type": "boolean" }
      },
      "oneOf": [
        {
          "properties": {
            "profile": { "const": "development" },
            "testSeamsEnabled": { "const": true }
          }
        },
        {
          "properties": {
            "profile": { "const": "release" },
            "testSeamsEnabled": { "const": false }
          }
        }
      ]
    },
    "ready": { "type": "boolean" },
    "cwd": { "type": "string", "minLength": 1 },
    "selectedHarness": { "type": "string", "minLength": 1 },
    "selectedHarnessVersion": { "type": ["string", "null"] },
    "selectedTransport": { "type": "string", "minLength": 1 },
    "selectedAdapterId": { "type": "string", "minLength": 1 },
    "promptPlacement": { "enum": [null, "developer", "system-append", "user-prefix-framed"] },
    "isolation": { "$ref": "common.schema.json#/$defs/guarantee" },
    "authCategory": { "$ref": "common.schema.json#/$defs/authCategory" },
    "selectedAuthReadiness": { "enum": ["ready", "required", "unknown", "not-applicable"] },
    "billingOwner": { "$ref": "common.schema.json#/$defs/billingOwner" },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formatVersion", "version", "sha256", "releaseEligible"],
      "properties": {
        "formatVersion": { "const": "openprose.skill-runtime-image/1" },
        "version": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "common.schema.json#/$defs/sha256" },
        "releaseEligible": { "type": "boolean" }
      }
    },
    "configuration": { "$ref": "configuration-explanation.schema.json" },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "harness-list.schema.json#/$defs/harness" }
    },
    "problems": {
      "type": "array",
      "items": { "$ref": "runner-error.schema.json" }
    }
  }
}
