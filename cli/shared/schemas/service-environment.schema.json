{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openprose.org/cli/v1/service-environment.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "environment",
    "source",
    "problem"
  ],
  "properties": {
    "schema": {
      "const": "openprose.service-environment/1"
    },
    "environment": {
      "enum": [
        "production",
        "staging"
      ]
    },
    "source": {
      "enum": [
        "default",
        "user-config"
      ]
    },
    "problem": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "runner-error.schema.json"
        }
      ]
    }
  }
}
