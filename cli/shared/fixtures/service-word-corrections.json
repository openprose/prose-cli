    "helpAndSavedProgramWithoutFileUnchanged": true,
    "cwdPrefixLastWins": true,
    "existingServiceTailModelWinsWithoutDuplication": true,
    "duplicateGlobalModelRejected": true,
    "convertedOptionsBeforeDelimiter": true
