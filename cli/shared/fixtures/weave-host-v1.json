{
  "schema": "openprose.weave-host-fixture/1",
  "status": "proposed-not-released",
  "contract": "cli/protocol/decisions/weave-host.md",
  "harness": {
    "description": "Declarative self-contained bridge corpus, not runner-case/1. Independent root-owned harness must expand tokens and construct real fake executables. Missing host stdout/stderr defaults empty; missing host exit defaults0. Cases are not claimed executed by this fixture. Token expansion also applies inside raw binding JSON strings before writing UTF-8 bytes.",
    "tokens": {
      "{{ROOT}}": "fresh canonical absolute temporary directory",
      "{{BINDING}}": "ROOT/host.json",
      "{{CONFIG}}": "ROOT/weave.json (need not exist)",
      "{{HOST}}": "ROOT/fake-host",
      "{{HOST_SHA256}}": "actual fake-host executable SHA256"
    },
    "baseBinding": {
      "schema": "openprose.weave-host-binding/1",
      "executable": "{{HOST}}",
      "sha256": "{{HOST_SHA256}}",
      "environmentKeys": [],
      "timeoutMs": 2000,
      "maxOutputBytes": 65536
    },
    "mutationOrder": [
      "construct fake host",
      "derive base binding with its actual digest",
      "apply bindingPatch or bindingRawUtf8 or bindingFile",
      "apply hostFile mutation",
      "launch CLI under selected ambient and control"
    ],
    "ambientDefault": {},
    "network": "denied",
    "providerCalls": 0,
    "outerTestTimeoutMs": 10000,
    "notes": [
      "Hex expectations refer to raw bytes, including malformed UTF8.",
      "Generic stderr expectations cover wrapper output only unless suffix is specified.",
      "Timing upper bounds include CI scheduling allowance, not a runtime deadline extension.",
      "Harness must clean its intentionally detached fake descendants itself.",
      "Sparse oversized executable fixture avoids allocating536MiB.",
      "Structured fake behaviors must use literal argv and no shell."
    ]
  },
  "cases": [
    {
      "id": "forward-check",
      "argv": [
        "cli",
