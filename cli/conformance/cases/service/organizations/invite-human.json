{
  "id": "invite-human",
  "feature": "organizations",
  "operation": "org.invite",
  "description": "Human invite output shows the token once, with how the invitee accepts it.",
  "argv": [
    "cli",
    "org",
    "invite",
    "acme-research",
    "cus_ExampleInvitee1",
    "--role",
    "developer",
    "--expires-in",
    "3600",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/organizations/acme-research/invitations",
        "requestHeaders": {
          "Authorization": {
            "present": true
          },
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "status": 201,
        "body": {
          "invitation": {
            "id": "7e6d5c4b-3a29-4817-8f6e-5d4c3b2a1908",
            "organization_id": "5b0e7c1a-3f2d-4e8b-9a61-2c4d8e0f1a23",
            "account_id": "cus_ExampleInvitee1",
            "role": "developer",
            "created_by": "cus_ExampleAdmin01",
            "created_at": 1790100000000,
            "expires_at": 1790103600000,
            "consumed_at": null,
            "revoked_at": null
          },
          "token": "3f1c2b8e-9d7a-4c6b-8e5f-0a1b2c3d4e5fa9b8c7d6-e5f4-4a3b-9c2d-1e0f9a8b7c6d"
        },
        "expectedBody": {
          "accountId": "cus_ExampleInvitee1",
          "expiresInSeconds": 3600,
          "role": "developer"
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "text": "Invitation 7e6d5c4b-3a29-4817-8f6e-5d4c3b2a1908 for cus_ExampleInvitee1 as developer (expires 2026-09-22T19:00:00.000Z).\nToken: 3f1c2b8e-9d7a-4c6b-8e5f-0a1b2c3d4e5fa9b8c7d6-e5f4-4a3b-9c2d-1e0f9a8b7c6d\nThe token appears only here. The invitee accepts with `prose cli org invitation accept --token-file FILE`.\n"
  },
  "stderr": {
    "text": ""
  }
}
