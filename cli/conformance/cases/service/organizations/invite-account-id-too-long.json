{
  "id": "invite-account-id-too-long",
  "feature": "organizations",
  "operation": "org.invite",
  "description": "ACCOUNT_ID over 128 code points is INVOCATION_INVALID and nothing is sent (the service would accept 256, create the invitation, and the CLI could not project its echo, losing the one-time token).",
  "argv": [
    "--output",
    "json",
    "cli",
    "org",
    "invite",
    "acme-research",
    "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
    "--role",
    "reader",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": []
  },
  "exitCode": 2,
  "stdout": {
    "json": {
      "interaction": "organizations.manage",
      "operation": "org.invite",
      "problem": {
        "action": "Correct the value named in Detail; `prose --output json cli org invite --help` shows the accepted syntax.",
        "boundary": "invocation",
        "code": "INVOCATION_INVALID",
        "details": {
          "reason": "<ACCOUNT_ID> must be 1-128 characters with no control characters",
          "suggestedArgv": [
            "--output",
            "json",
            "cli",
            "org",
            "invite",
            "--help"
          ]
        },
        "exitCode": 2,
        "message": "That command isn't quite right.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
