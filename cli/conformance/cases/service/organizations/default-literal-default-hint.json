{
  "id": "default-literal-default-hint",
  "feature": "organizations",
  "operation": "org.default",
  "description": "`org default default` gets the same teaching reason on not-found.",
  "argv": [
    "--output",
    "json",
    "cli",
    "org",
    "default",
    "default",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "PUT",
        "path": "/organizations/default",
        "requestHeaders": {
          "Authorization": {
            "present": true
