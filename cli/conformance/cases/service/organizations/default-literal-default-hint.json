          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "status": 404,
        "body": {
          "error": "Organization not found",
          "code": "organization_not_found"
        },
        "expectedBody": {
          "organization": "default"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
