{
  "id": "invitation-accept-invalid",
  "feature": "organizations",
  "operation": "org.invitation.accept",
  "description": "invalid_invitation (400) is SERVICE_REQUEST_REJECTED with the message; the token is not echoed.",
  "argv": [
    "--output",
    "json",
    "cli",
    "org",
    "invitation",
    "accept",
    "--token-file",
    "invite.token",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/organizations/invitations/accept",
        "requestHeaders": {
          "Authorization": {
            "present": true
          },
          "Accept": "application/json",
          "Content-Type": "application/json"
        },
        "status": 400,
        "body": {
          "error": "Invitation is invalid, expired, or already used",
          "code": "invalid_invitation"
        },
        "expectedBody": {
          "token": "3f1c2b8e-9d7a-4c6b-8e5f-0a1b2c3d4e5fa9b8c7d6-e5f4-4a3b-9c2d-1e0f9a8b7c6d"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "organizations.manage",
      "operation": "org.invitation.accept",
      "problem": {
        "action": "Correct the request as details.reason and details.serviceMessage describe, then retry.",
        "boundary": "hosted-service",
        "code": "SERVICE_REQUEST_REJECTED",
        "exitCode": 10,
        "message": "The OpenProse service rejected the request.",
        "retryable": false,
        "schema": "openprose.runner-error/1",
        "details": {
          "reason": "the invitation token is invalid, expired, revoked, already used, or was issued to a different account",
          "serviceMessage": "Invitation is invalid, expired, or already used",
          "serviceStatus": 400
        }
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "files": [
    {
      "path": "invite.token",
      "content": "3f1c2b8e-9d7a-4c6b-8e5f-0a1b2c3d4e5fa9b8c7d6-e5f4-4a3b-9c2d-1e0f9a8b7c6d\n"
    }
  ],
  "forbid": [
    "3f1c2b8e-9d7a-4c6b-8e5f-0a1b2c3d4e5fa9b8c7d6-e5f4-4a3b-9c2d-1e0f9a8b7c6d"
  ]
}
