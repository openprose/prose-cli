{
  "id": "auth-status-live-prefix-key",
  "feature": "account",
  "operation": "auth.status",
  "description": "An rr_live_ key is malformed (not an OpenProse API key) and the reason names the prefix.",
  "argv": [
    "--output",
    "json",
    "cli",
    "auth",
    "status"
  ],
  "environment": {
    "OPENPROSE_API_KEY": "rr_live_0123456789abcdef0123456789abcdef"
  },
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": null
    },
    "storeAvailable": true,
    "exchanges": []
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "schema": "openprose.service-operation/1",
      "operation": "auth.status",
      "interaction": "cli.auth_status",
      "result": null,
      "problem": {
        "action": "Replace or unset OPENPROSE_API_KEY, then retry.",
        "boundary": "authentication",
        "code": "SERVICE_AUTH_REQUIRED",
        "details": {
          "credentialProblem": "malformed",
          "credentialSource": "environment",
          "credentialVariable": "OPENPROSE_API_KEY",
          "reason": "the OPENPROSE_API_KEY value starts with rr_live_, which is not an OpenProse API key (an OpenProse API key is rr_test, an underscore and 32 lowercase hex digits); replace or unset OPENPROSE_API_KEY"
        },
        "exitCode": 10,
        "message": "OpenProse service authentication is required.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      }
    }
  },
  "forbid": [
    "rr_live_0123456789abcdef0123456789abcdef"
  ]
}
