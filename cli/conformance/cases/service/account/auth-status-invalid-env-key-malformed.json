{
  "id": "auth-status-invalid-env-key-malformed",
  "feature": "account",
  "operation": "auth.status",
  "description": "An OPENPROSE_API_KEY that is not an OpenProse key is malformed: nothing is sent and the value is never echoed. Ported from the account corpus.",
  "argv": [
    "--output",
    "json",
    "cli",
    "auth",
    "status"
  ],
  "fixture": {
    "credential": null,
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/organizations",
        "status": 200,
        "body": {
          "organizations": [
            {
              "id": "org-fixture",
              "slug": "fixture",
              "name": "Fixture",
              "role": "admin"
            }
          ]
        }
      }
    ]
  },
  "exitCode": 10,
  "environment": {
    "OPENPROSE_API_KEY": "wrong-token"
  },
  "stdout": {
    "json": {
      "schema": "openprose.service-operation/1",
      "operation": "auth.status",
      "interaction": "cli.auth_status",
      "result": null,
      "problem": {
        "action": "Replace or unset OPENPROSE_API_KEY, then retry.",
        "boundary": "authentication",
        "code": "SERVICE_AUTH_REQUIRED",
        "details": {
          "credentialProblem": "malformed",
          "credentialSource": "environment",
          "credentialVariable": "OPENPROSE_API_KEY",
          "reason": "the OPENPROSE_API_KEY value is not a valid OpenProse API key (an OpenProse API key is rr_test, an underscore and 32 lowercase hex digits); replace or unset OPENPROSE_API_KEY: an environment key takes precedence over `prose --output json cli auth login`"
        },
        "exitCode": 10,
        "message": "OpenProse service authentication is required.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      }
    }
  },
  "stderr": {
    "empty": true
  }
}
