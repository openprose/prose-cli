          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          }
        },
        "status": 200,
        "body": {
          "status": "ok",
          "environments": {
            "default": "builtin",
            "available": [
              "builtin",
              "linux"
            ]
          },
          "models": [
            "model-sol",
            "model-luna"
          ],
          "default_model": "model-sol",
          "version": "9.9.9-extra",
          "capabilities": {
            "web:search": {
              "available": true,
              "tool": "web_search"
            }
          }
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "json": {
      "interaction": "health.read",
      "operation": "service.status",
      "problem": null,
      "result": {
        "default_model": "model-sol",
        "environments": [
          "builtin",
          "linux"
        ],
        "models": [
          "model-sol",
          "model-luna"
        ],
        "status": "ok"
      },
      "schema": "openprose.service-operation/1"
    }
  }
