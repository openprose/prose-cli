{
  "id": "no-color-after-command-path",
  "feature": "framework",
  "operation": "service.status",
  "description": "`--no-color` after the command path is accepted like the global one.",
  "argv": [
    "--output",
    "json",
    "cli",
    "service",
    "status",
    "--no-color"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/health",
        "requestHeaders": {
          "Authorization": {
            "present": false
