{
  "id": "unsplit-argv-after-cli",
  "feature": "framework",
  "operation": "run.list",
  "description": "`prose cli \"run list --limit 5\"` (one quoted word after `cli`) suggests the split argv.",
  "argv": [
    "--output",
    "json",
    "cli",
    "run list --limit 5"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": null
    },
    "storeAvailable": true,
    "exchanges": []
  },
  "exitCode": 2,
  "stdout": {
    "json": {
      "interaction": null,
