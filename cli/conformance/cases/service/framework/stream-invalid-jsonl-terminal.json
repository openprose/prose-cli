{
  "id": "stream-invalid-jsonl-terminal",
  "feature": "framework",
  "operation": "run.submit",
  "description": "In JSONL mode a stream operation's failure is exactly one service.failed terminal line.",
  "argv": [
    "--output",
    "jsonl",
    "cli",
    "run",
    "submit",
    "p.md",
    "--detach",
    "--detach"
