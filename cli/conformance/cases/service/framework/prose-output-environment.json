{
  "id": "prose-output-environment",
  "feature": "framework",
  "operation": "repo.list",
  "description": "PROSE_OUTPUT selects the output mode when no flag does.",
  "argv": [
    "cli",
    "repo",
    "list"
  ],
  "environment": {
    "PROSE_OUTPUT": "json"
  },
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/repos",
        "status": 503,
        "bodyText": ""
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "repos.list",
      "operation": "repo.list",
      "problem": {
        "action": "Check your network connection and retry later.",
        "boundary": "hosted-service",
        "code": "SERVICE_UNAVAILABLE",
        "details": {
          "serviceStatus": 503
        },
        "exitCode": 10,
        "message": "The OpenProse service is unavailable.",
        "retryable": true,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
