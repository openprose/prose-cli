{
  "id": "no-cli-list-jobs",
  "feature": "framework",
  "operation": "job.list",
  "description": "`prose list jobs` puts the command word first: `prose cli job list`, never `cli run list`.",
  "argv": [
    "--output",
    "json",
    "list",
    "jobs"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": null
    },
    "storeAvailable": true,
    "exchanges": []
  },
  "exitCode": 2,
  "stdout": {
    "json": {
      "interaction": null,
      "operation": "cli",
      "problem": {
        "action": "Use `cli job list`: `prose --output json cli job list`.",
        "boundary": "invocation",
        "code": "INVOCATION_INVALID",
        "details": {
          "reason": "`list jobs` is not a command; did you mean `prose --output json cli job list`? Nothing was forwarded or sent. To pass these words to the OpenProse language instead, put `--` before them",
          "suggestedArgv": [
            "--output",
            "json",
            "cli",
            "job",
            "list"
          ]
        },
        "exitCode": 2,
        "message": "Unknown command.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
