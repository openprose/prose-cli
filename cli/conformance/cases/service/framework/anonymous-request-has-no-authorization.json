{
  "id": "anonymous-request-has-no-authorization",
  "feature": "framework",
  "operation": "service.status",
  "description": "An anonymous route sends no Authorization header even when a key is available.",
  "argv": [
    "--output",
    "json",
    "cli",
    "service",
    "status"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/health",
        "status": 503,
        "bodyText": "",
        "requestHeaders": {
          "Authorization": {
            "present": false
          },
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          }
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "health.read",
      "operation": "service.status",
      "problem": {
        "action": "Check your network connection and retry later.",
        "boundary": "hosted-service",
        "code": "SERVICE_UNAVAILABLE",
        "details": {
          "serviceStatus": 503
        },
        "exitCode": 10,
        "message": "The OpenProse service is unavailable.",
        "retryable": true,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
