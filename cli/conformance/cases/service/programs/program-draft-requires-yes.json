{
  "id": "program-draft-requires-yes",
  "feature": "programs",
  "operation": "program.draft",
  "description": "`program draft` is paid: without --yes it exits 2 with the planned POST /write (body digest) and sends nothing. The plan carries the flat run hold from GET /run/quote.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "draft",
    "write a haiku about rain"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/run/quote",
        "requestHeaders": {
          "Authorization": {
            "present": false
          }
        },
        "status": 200,
        "body": {
          "hold": {
            "hold_usd": "1.02",
            "ttl_seconds": 900
          },
          "pricing_policy_id": "pricing-policy.sha256.f114eadc02b7550e58f12c49996382b04f867cb774ac295506806f599ef1e3cd",
          "note": "Unused hold is released when the run settles."
        }
      }
    ]
  },
  "exitCode": 2,
  "stdout": {
    "json": {
      "interaction": "write.author",
      "operation": "program.draft",
      "problem": {
        "action": "Rerun the same command with --yes to confirm, or with --preview to see what it would do without sending anything.",
        "boundary": "invocation",
        "code": "CONFIRMATION_REQUIRED",
        "details": {
          "confirmArgv": [
            "--output",
            "json",
            "cli",
            "program",
            "draft",
            "write a haiku about rain",
            "--yes"
          ],
          "plannedRequest": {
            "bodyBytes": 38,
            "bodySha256": "e9c8d38e6d195125958e3ab5b8a64549d354645cbb72152b4baf39df3a843717",
            "description": "Draft a program from a sentence with the hosted writer.",
            "effect": "money",
            "method": "POST",
            "operation": "program.draft",
            "quote": {
              "hold": {
                "hold_cents": 102,
                "hold_usd": "1.02",
                "ttl_seconds": 900
              }
            }
          },
          "previewArgv": [
            "--output",
            "json",
            "cli",
            "program",
            "draft",
            "write a haiku about rain",
            "--preview"
          ],
          "reason": "--yes is required because it starts a paid writer run: a hold is reserved from the wallet now and the run's price is charged when it settles"
        },
        "exitCode": 2,
        "message": "This service operation requires explicit confirmation.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
