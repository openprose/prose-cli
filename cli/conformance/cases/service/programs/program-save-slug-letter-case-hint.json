{
  "id": "program-save-slug-letter-case-hint",
  "feature": "programs",
  "operation": "program.save",
  "description": "An upper-case slug is INVOCATION_INVALID before any request and names the lower-case slug; the reason describes the slug in words, not as a regex.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "save",
    "Demo",
    "demo.prose.md"
  ],
