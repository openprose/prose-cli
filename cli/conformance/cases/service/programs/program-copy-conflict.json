{
  "id": "program-copy-conflict",
  "feature": "programs",
  "operation": "program.copy",
  "description": "A slug the organization already has is a write conflict (`program_exists`) with the service's message.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "copy",
    "bob/tool@0123456789abcdef",
    "--to",
    "acme",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/p/bob/tool@0123456789abcdef/copy",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 409,
        "expectedBody": {
          "to": "acme"
        },
        "body": {
          "error": "\"acme/tool\" already exists. Copy it under a different slug.",
          "code": "program_exists"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "program.copy",
      "operation": "program.copy",
      "problem": {
        "action": "Read the current state of the resource, reconcile the change, then retry.",
        "boundary": "hosted-service",
        "code": "SERVICE_WRITE_CONFLICT",
        "details": {
          "serviceCode": "program_exists",
          "serviceMessage": "\"acme/tool\" already exists. Copy it under a different slug.",
          "serviceStatus": 409
        },
        "exitCode": 10,
        "message": "The OpenProse service reported a conflicting write.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
