{
  "id": "program-draft-feature-disabled",
  "feature": "programs",
  "operation": "program.draft",
  "description": "A feature_disabled answer to a draft is SERVICE_FEATURE_DISABLED (body code before status); the feature name is never echoed.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "draft",
    "write a haiku about rain",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/write",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "text/event-stream",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef",
          "Content-Type": "application/json"
        },
        "expectedBody": {
          "request": "write a haiku about rain"
        },
        "status": 403,
        "body": {
          "error": "example_feature is disabled",
          "code": "feature_disabled",
          "feature": "example_feature"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "schema": "openprose.service-operation/1",
      "operation": "program.draft",
      "interaction": "write.author",
      "result": null,
      "problem": {
        "schema": "openprose.runner-error/1",
        "code": "SERVICE_FEATURE_DISABLED",
        "boundary": "hosted-service",
        "message": "This capability is not available for this account.",
        "action": "Check your plan or organization, or contact OpenProse support.",
        "exitCode": 10,
        "retryable": false,
        "details": {
          "serviceStatus": 403,
          "serviceCode": "feature_disabled"
        }
      }
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef",
    "example_feature",
    "example_feature is disabled"
  ]
}
