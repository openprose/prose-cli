{
  "id": "program-save-github-link-required",
  "feature": "programs",
  "operation": "program.save",
  "description": "PUT /programs/{slug} 403 whose text is the linked-login refusal is GITHUB_LINK_REQUIRED.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "save",
    "demo",
    "demo.prose.md"
  ],
  "files": [
    {
      "path": "demo.prose.md",
      "content": "---\nname: demo\nkind: function\n---\n\n### Returns\n\n- `text`: exactly `ok`\n"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "PUT",
        "path": "/programs/demo",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 403,
        "expectedBody": {
          "content": "---\nname: demo\nkind: function\n---\n\n### Returns\n\n- `text`: exactly `ok`\n"
        },
        "body": {
          "error": "Sharing requires a linked GitHub login (it becomes your public handle). Sign in via GitHub first."
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "schema": "openprose.service-operation/1",
      "operation": "program.save",
      "interaction": "program.save",
      "result": null,
      "problem": {
        "schema": "openprose.runner-error/1",
        "code": "GITHUB_LINK_REQUIRED",
        "boundary": "authentication",
        "message": "This operation needs a linked GitHub account on the OpenProse account.",
        "action": "Link or reconnect GitHub for this account in the OpenProse web app, then retry; the API key itself is valid.",
        "exitCode": 10,
        "retryable": false,
        "details": {
          "serviceStatus": 403
        }
      }
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
