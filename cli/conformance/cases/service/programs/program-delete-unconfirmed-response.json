{
  "id": "program-delete-unconfirmed-response",
  "feature": "programs",
  "operation": "program.delete",
  "description": "A 2xx without deleted:true is SERVICE_PROTOCOL_INVALID.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "delete",
    "demo",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "DELETE",
        "path": "/programs/demo",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 200,
        "body": {
          "ok": true
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "schema": "openprose.service-operation/1",
      "operation": "program.delete",
      "interaction": "program.delete",
      "result": null,
      "problem": {
        "schema": "openprose.runner-error/1",
        "code": "SERVICE_PROTOCOL_INVALID",
        "boundary": "protocol",
        "message": "The OpenProse service returned an invalid response.",
        "action": "Retry later and report the sanitized error code if it persists.",
        "exitCode": 10,
        "retryable": false,
        "details": {
          "reason": "the service did not confirm the deletion"
        }
      }
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
