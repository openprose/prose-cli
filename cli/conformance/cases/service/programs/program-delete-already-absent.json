{
  "id": "program-delete-already-absent",
  "feature": "programs",
  "operation": "program.delete",
  "description": "A confirmed delete of a program that is already gone is idempotent: the 404 exits 0 with deleted: true and alreadyAbsent: true.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "delete",
    "demo",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "DELETE",
        "path": "/programs/demo",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 404,
        "body": {
          "error": "Not found"
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "json": {
      "interaction": "program.delete",
      "operation": "program.delete",
      "problem": null,
      "result": {
        "alreadyAbsent": true,
        "deleted": true,
        "slug": "demo"
      },
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
