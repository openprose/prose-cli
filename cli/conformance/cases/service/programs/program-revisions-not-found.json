{
  "id": "program-revisions-not-found",
  "feature": "programs",
  "operation": "program.revisions",
  "description": "Revisions of a missing program are SERVICE_RESOURCE_NOT_FOUND.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "revisions",
    "nope"
  ],
  "fixture": {
