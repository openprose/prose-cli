{
  "id": "program-save-human",
  "feature": "programs",
  "operation": "program.save",
  "description": "Human mode confirms the saved name, rev and commit.",
  "argv": [
    "cli",
    "program",
    "save",
    "demo",
    "demo.prose.md"
  ],
  "files": [
    {
      "path": "demo.prose.md",
      "content": "---\nname: demo\nkind: function\n---\n\n### Returns\n\n- `text`: exactly `ok`\n"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "PUT",
        "path": "/programs/demo",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 200,
        "expectedBody": {
          "content": "---\nname: demo\nkind: function\n---\n\n### Returns\n\n- `text`: exactly `ok`\n"
        },
        "body": {
          "program": {
            "owner": "alice",
            "slug": "demo",
            "visibility": "private",
            "content": "---\nname: demo\nkind: function\n---\n\n### Returns\n\n- `text`: exactly `ok`\n",
            "rev": 1,
            "rev_id": "0123456789abcdef",
            "commit_id": "1111111111111111",
            "parent_commit_id": null,
            "updated_at": 1790212199320
          },
          "url": "/p/alice/demo"
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "text": "Saved alice/demo rev 1: ref alice/demo@0123456789abcdef (commit 1111111111111111)\n"
  },
  "stderr": {
    "text": ""
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
