{
  "id": "program-copy-slug-owned-elsewhere",
  "feature": "programs",
  "operation": "program.copy",
  "description": "The service's 403 slug refusal is a rejected request, not a key problem.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "copy",
    "bob/tool@0123456789abcdef",
    "--to",
    "acme",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/p/bob/tool@0123456789abcdef/copy",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 403,
        "expectedBody": {
          "to": "acme"
        },
        "body": {
          "error": "Slug is owned by a different account."
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "program.copy",
      "operation": "program.copy",
      "problem": {
        "action": "Correct the request as details.serviceMessage describes, then retry.",
        "boundary": "hosted-service",
        "code": "SERVICE_REQUEST_REJECTED",
        "details": {
          "serviceMessage": "Slug is owned by a different account.",
          "serviceStatus": 403
        },
        "exitCode": 10,
        "message": "The OpenProse service rejected the request.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
