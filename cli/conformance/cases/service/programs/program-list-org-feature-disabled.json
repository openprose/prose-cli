{
  "id": "program-list-org-feature-disabled",
  "feature": "programs",
  "operation": "program.list",
  "description": "A service without organization programs refuses `?workspace=` as a disabled feature; nothing falls back to the personal list.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "list",
    "--org",
    "acme"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/programs",
        "query": {
          "workspace": "acme"
        },
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 404,
        "body": {
          "error": "Not found",
          "code": "feature_disabled",
          "feature": "example_feature"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "programs.list",
      "operation": "program.list",
      "problem": {
        "action": "Check your plan or organization, or contact OpenProse support.",
        "boundary": "hosted-service",
        "code": "SERVICE_FEATURE_DISABLED",
        "details": {
          "serviceCode": "feature_disabled",
          "serviceStatus": 404
        },
        "exitCode": 10,
        "message": "This capability is not available for this account.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
