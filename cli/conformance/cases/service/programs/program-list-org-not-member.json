{
  "id": "program-list-org-not-member",
  "feature": "programs",
  "operation": "program.list",
  "description": "The service answers a non-member and an unknown organization with the same plain 404; the listing reads it as the organization not found and names `cli org list`.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "list",
    "--org",
    "acme"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/programs",
        "query": {
          "workspace": "acme"
        },
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 404,
        "body": {
          "error": "Not found"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "programs.list",
      "operation": "program.list",
      "problem": {
        "action": "Run `prose --output json cli org list` to find the right organization, then retry with it.",
        "boundary": "hosted-service",
        "code": "SERVICE_RESOURCE_NOT_FOUND",
        "details": {
          "reason": "organization acme was not found, or you are not a member of it",
          "resource": {
            "id": "acme",
            "kind": "organization"
          },
          "serviceStatus": 404,
          "suggestedArgv": [
            "--output",
            "json",
            "cli",
            "org",
            "list"
          ]
        },
        "exitCode": 10,
        "message": "The requested OpenProse service resource was not found.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
