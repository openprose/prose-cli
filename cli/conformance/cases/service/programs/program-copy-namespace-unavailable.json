{
  "id": "program-copy-namespace-unavailable",
  "feature": "programs",
  "operation": "program.copy",
  "description": "An organization that cannot hold programs (`workspace_namespace_unavailable`) is refused with a reason naming it.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "copy",
    "bob/tool@0123456789abcdef",
    "--to",
    "acme",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/p/bob/tool@0123456789abcdef/copy",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 409,
        "expectedBody": {
          "to": "acme"
        },
        "body": {
          "error": "\"acme\" is a personal organization named after a GitHub login, so it cannot own programs. Save to your personal workspace instead.",
          "code": "workspace_namespace_unavailable"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "program.copy",
      "operation": "program.copy",
      "problem": {
        "action": "Copy into another organization (`prose --output json cli org list` lists your organizations).",
        "boundary": "hosted-service",
        "code": "SERVICE_REQUEST_REJECTED",
        "details": {
          "reason": "organization acme cannot hold programs: its slug is not an eligible program namespace",
          "serviceCode": "workspace_namespace_unavailable",
          "serviceMessage": "\"acme\" is a personal organization named after a GitHub login, so it cannot own programs. Save to your personal workspace instead.",
          "serviceStatus": 409
        },
        "exitCode": 10,
        "message": "The OpenProse service rejected the request.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
