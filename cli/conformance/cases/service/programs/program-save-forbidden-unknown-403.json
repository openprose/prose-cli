{
  "id": "program-save-forbidden-unknown-403",
  "feature": "programs",
  "operation": "program.save",
  "description": "A 403 without the linked-login text (no JSON body) is the status default SERVICE_AUTH_REQUIRED.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "save",
    "demo",
    "demo.prose.md"
  ],
  "files": [
    {
      "path": "demo.prose.md",
      "content": "---\nname: demo\nkind: function\n---\n\n### Returns\n\n- `text`: exactly `ok`\n"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "PUT",
        "path": "/programs/demo",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 403,
        "expectedBody": {
          "content": "---\nname: demo\nkind: function\n---\n\n### Returns\n\n- `text`: exactly `ok`\n"
        },
        "bodyText": "Forbidden"
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "program.save",
      "operation": "program.save",
      "problem": {
        "action": "Run cli auth login, then retry.",
        "boundary": "authentication",
        "code": "SERVICE_AUTH_REQUIRED",
        "details": {
          "credentialSource": "store",
          "credentialVariable": "OPENPROSE_API_KEY",
          "serviceStatus": 403
        },
        "exitCode": 10,
        "message": "OpenProse service authentication is required.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
