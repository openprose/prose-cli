{
  "id": "program-revisions-human",
  "feature": "programs",
  "operation": "program.revisions",
  "description": "Human mode prints rev, rev_id, commit and message per line.",
  "argv": [
    "cli",
    "program",
    "revisions",
    "demo"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
