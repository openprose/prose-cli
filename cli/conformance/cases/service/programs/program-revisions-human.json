  },
  "exitCode": 0,
  "stdout": {
    "text": "rev 2  rev_id=fedcba9876543210  commit_id=2222222222222222  ref=alice/demo@fedcba9876543210  second\nrev 1  rev_id=0123456789abcdef  commit_id=1111111111111111  ref=alice/demo@0123456789abcdef\n"
  },
  "stderr": {
    "text": ""
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
