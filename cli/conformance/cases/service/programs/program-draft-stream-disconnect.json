{
  "id": "program-draft-stream-disconnect",
  "feature": "programs",
  "operation": "program.draft",
  "description": "A stream that drops after the run started is SERVICE_UNAVAILABLE naming the run to inspect; nothing is resubmitted.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "draft",
    "write a haiku about rain",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/write",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "text/event-stream",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef",
          "Content-Type": "application/json"
        },
        "expectedBody": {
          "request": "write a haiku about rain"
        },
        "status": 200,
        "sse": {
          "frames": [
            {
              "event": "status",
              "data": {
                "type": "status",
                "status": "running",
                "run_id": "run_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
                "message": "reactor model-luna"
              }
            }
          ],
          "end": "disconnect"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "schema": "openprose.service-operation/1",
      "operation": "program.draft",
      "interaction": "write.author",
      "result": null,
      "problem": {
        "schema": "openprose.runner-error/1",
        "code": "SERVICE_UNAVAILABLE",
        "boundary": "hosted-service",
        "message": "The OpenProse service is unavailable.",
        "action": "Check your network connection and retry later.",
        "exitCode": 10,
        "retryable": true,
        "details": {
          "runId": "run_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
          "reason": "the draft stream ended before the run finished; inspect it with `cli run show run_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa`"
        }
      }
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
