{
  "id": "alias-program-rm-deletes",
  "feature": "programs",
  "operation": "program.delete",
  "description": "`cli program rm SLUG --yes` is an alias of `cli program delete`.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "rm",
    "demo",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "DELETE",
        "path": "/programs/demo",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 200,
        "body": {
          "deleted": true
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "json": {
      "interaction": "program.delete",
      "operation": "program.delete",
      "problem": null,
      "result": {
        "deleted": true,
        "slug": "demo"
      },
      "schema": "openprose.service-operation/1"
    }
  }
}
