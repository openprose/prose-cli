{
  "id": "program-save-org-reader-forbidden",
  "feature": "programs",
  "operation": "program.save",
  "description": "A reader's save is refused by the service; the error names the role it needs.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "save",
    "hello",
    "hello.prose.md",
    "--org",
    "acme"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/programs",
        "query": {
          "workspace": "acme"
        },
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 200,
        "body": {
          "programs": [],
          "workspace": {
            "slug": "acme",
            "name": "Acme",
            "role": "admin"
          }
        }
      },
      {
        "method": "PUT",
        "path": "/programs/hello",
        "query": {
          "workspace": "acme"
        },
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 403,
        "expectedBody": {
          "content": "---\nname: hello\nkind: function\n---\n\n### Returns\n\n- `text`: exactly `ok`\n"
        },
        "body": {
          "error": "Saving programs in this organization needs the developer or admin role.",
          "code": "organization_forbidden"
        }
      }
    ]
  },
  "exitCode": 10,
  "files": [
    {
      "path": "hello.prose.md",
      "content": "---\nname: hello\nkind: function\n---\n\n### Returns\n\n- `text`: exactly `ok`\n"
    }
  ],
  "stdout": {
    "json": {
      "interaction": "program.save",
      "operation": "program.save",
      "problem": {
        "action": "Ask an admin of acme for the developer role, or act on your own programs without --org.",
        "boundary": "hosted-service",
        "code": "SERVICE_REQUEST_REJECTED",
        "details": {
          "reason": "your role in organization acme does not allow this: saving a program needs the developer role (reader can read and run; developer can also create, edit and copy in; admin can also change visibility and delete)",
          "requiredRole": "developer",
          "serviceCode": "organization_forbidden",
          "serviceStatus": 403
        },
        "exitCode": 10,
        "message": "The OpenProse service rejected the request.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
