{
  "id": "program-delete-yes",
  "feature": "programs",
  "operation": "program.delete",
  "description": "`delete SLUG --yes` sends DELETE and reports {slug, deleted: true}.",
  "argv": [
    "--output",
    "json",
    "cli",
    "program",
    "delete",
    "demo",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "DELETE",
        "path": "/programs/demo",
        "requestHeaders": {
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "User-Agent": {
            "pattern": "^prose-cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "Accept": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "status": 200,
        "body": {
          "deleted": true
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "json": {
      "schema": "openprose.service-operation/1",
      "operation": "program.delete",
      "interaction": "program.delete",
      "result": {
        "slug": "demo",
        "deleted": true
      },
      "problem": null
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
