{
  "id": "share-human-warns",
  "feature": "run-records",
  "operation": "run.share",
  "description": "Human share prints the URL on stdout and an unrevocable-link warning on stderr.",
  "argv": [
    "cli",
    "run",
    "share",
    "run_5e2a7c91d04b3f685e2a7c91d04b3f685e2a7c91d04b3f685e2a7c91d04b3f68",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/runs/run_5e2a7c91d04b3f685e2a7c91d04b3f685e2a7c91d04b3f685e2a7c91d04b3f68/share",
        "requestHeaders": {
          "Authorization": {
            "pattern": "^Bearer rr_test_[0-9a-f]{32}$"
          }
        },
        "status": 200,
        "body": {
          "url": "https://openprose.example/share/runs/run_5e2a7c91d04b3f685e2a7c91d04b3f685e2a7c91d04b3f685e2a7c91d04b3f68#tok=abcdef0123456789&exp=1790298569",
          "expires_in": 86400
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "text": "https://openprose.example/share/runs/run_5e2a7c91d04b3f685e2a7c91d04b3f685e2a7c91d04b3f685e2a7c91d04b3f68#tok=abcdef0123456789&exp=1790298569\nExpires: 2026-09-25T01:09:29Z\n"
  },
  "stderr": {
    "text": "Warning: anyone with this link can read this run's outputs for 24 hours, and it cannot be revoked. To give specific people access instead, invite them to your organization (`cli org invite`).\n"
  }
}
