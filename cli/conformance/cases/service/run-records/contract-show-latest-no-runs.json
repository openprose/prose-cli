{
  "id": "contract-show-latest-no-runs",
  "feature": "run-records",
  "operation": "run.show",
  "description": "`run show latest` on an account with no runs is SERVICE_RESOURCE_NOT_FOUND (10).",
  "argv": [
    "--output",
    "json",
    "cli",
    "run",
    "show",
    "latest"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/runs",
        "query": {
          "limit": "1"
        },
        "requestHeaders": {
          "Authorization": {
            "pattern": "^Bearer rr_test_[0-9a-f]{32}$"
          }
        },
        "status": 200,
        "body": {
          "runs": [],
          "next_before": null
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "run.read",
      "operation": "run.show",
      "problem": {
        "action": "Run `prose --output json cli run list --limit 5` to find the right run, then retry with it.",
        "boundary": "hosted-service",
        "code": "SERVICE_RESOURCE_NOT_FOUND",
        "details": {
          "reason": "run latest was not found: this account has no runs yet",
          "resource": {
            "id": "latest",
            "kind": "run"
          },
          "suggestedArgv": [
            "--output",
            "json",
            "cli",
            "run",
            "list",
            "--limit",
            "5"
          ]
        },
        "exitCode": 10,
        "message": "The requested OpenProse service resource was not found.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
