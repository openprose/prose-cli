              "source": "https://examples.example.org/examples/agent-native-change.prose.md"
            },
            {
              "id": "slack-hello",
              "label": "Slack hello",
              "source": "/examples/private/slack-hello"
            }
          ]
        }
      }
    ]
  },
  "exitCode": 2,
  "stdout": {
    "empty": true
  },
  "stderr": {
    "text": "OpenProse: EXAMPLE_NOT_VIEWABLE: This example is published outside the OpenProse service and cannot be shown here.\nDetail: example \"agent-native\" is published outside the OpenProse service, so its source cannot be shown here; view it on the web\nWeb: https://examples.example.org/examples/agent-native.prose.md\nAction: Read the example at the Web address above when one is printed, or pick an example that `cli example list` does not mark for viewing on the web.\n"
  }
