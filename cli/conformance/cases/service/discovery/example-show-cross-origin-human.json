{
  "id": "example-show-cross-origin-human",
  "feature": "discovery",
  "operation": "example.show",
  "description": "Human mode explains the refusal on stderr and prints nothing on stdout.",
  "argv": [
    "cli",
    "example",
    "show",
    "agent-native"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/examples/private",
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef",
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "Accept": "application/json"
        },
        "status": 200,
        "body": {
          "examples": [
            {
              "id": "private-example",
              "label": "Private example",
              "source": "/examples/private/private-example"
