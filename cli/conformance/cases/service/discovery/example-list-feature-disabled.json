{
  "id": "example-list-feature-disabled",
  "feature": "discovery",
  "operation": "example.list",
  "description": "A feature_disabled answer at 404 is SERVICE_FEATURE_DISABLED; the feature name is never echoed.",
  "argv": [
    "--output",
    "json",
    "cli",
    "example",
    "list"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/examples/private",
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef",
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "Accept": "application/json"
        },
        "status": 404,
        "body": {
          "error": "Not found",
          "code": "feature_disabled",
          "feature": "example_feature"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "schema": "openprose.service-operation/1",
      "operation": "example.list",
      "interaction": "examples.private",
      "result": null,
      "problem": {
        "schema": "openprose.runner-error/1",
        "code": "SERVICE_FEATURE_DISABLED",
        "boundary": "hosted-service",
        "exitCode": 10,
        "retryable": false,
        "message": "This capability is not available for this account.",
        "action": "Check your plan or organization, or contact OpenProse support.",
        "details": {
          "serviceStatus": 404,
          "serviceCode": "feature_disabled"
        }
      }
    }
  },
  "forbid": [
    "example_feature",
    "Not found"
  ]
}
