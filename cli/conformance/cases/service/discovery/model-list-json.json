{
  "id": "model-list-json",
  "feature": "discovery",
  "operation": "model.list",
  "description": "Reads authenticated /models only (includes model-astra, which /health omits) and reports exactly the models it lists plus default_model.",
  "argv": [
    "--output",
    "json",
    "cli",
    "model",
    "list"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/models",
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef",
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "Accept": "application/json"
        },
        "status": 200,
        "body": {
          "models": [
            "model-astra",
            "model-sol",
            "model-luna"
          ],
          "default_model": "model-sol"
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "json": {
      "schema": "openprose.service-operation/1",
      "operation": "model.list",
      "interaction": "models.list",
      "result": {
        "models": [
          "model-astra",
          "model-sol",
          "model-luna"
        ],
        "default_model": "model-sol"
      },
      "problem": null
    }
  }
}
