{
  "id": "example-show-binary-body",
  "feature": "discovery",
  "operation": "example.show",
  "description": "Example bytes that are not UTF-8 text are SERVICE_PROTOCOL_INVALID and nothing is written.",
  "argv": [
    "--output",
    "json",
    "cli",
    "example",
    "show",
    "private-example",
    "--output-file",
    "x.md"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/examples/private",
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef",
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "Accept": "application/json"
        },
        "status": 200,
        "body": {
          "examples": [
            {
              "id": "private-example",
              "label": "Private example",
              "source": "/examples/private/private-example"
            },
            {
              "id": "private-agent-browser",
              "label": "Persona Website Feedback",
              "source": "/examples/private/private-agent-browser"
            },
            {
              "id": "agent-native",
              "label": "Agent-native",
              "source": "https://examples.example.org/examples/agent-native.prose.md"
            },
            {
              "id": "agent-native-change",
              "label": "Agent-native change",
              "source": "https://examples.example.org/examples/agent-native-change.prose.md"
            },
            {
              "id": "slack-hello",
              "label": "Slack hello",
              "source": "/examples/private/slack-hello"
            }
          ]
        }
      },
      {
        "method": "GET",
        "path": "/examples/private/private-example",
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef",
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "Accept": "application/json"
        },
        "status": 200,
        "bodyBase64": "//79AA=="
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "examples.private",
      "operation": "example.show",
      "problem": {
        "action": "Retry later and report the sanitized error code if it persists.",
        "boundary": "protocol",
        "code": "SERVICE_PROTOCOL_INVALID",
        "details": {
          "reason": "unexpected example response: body"
        },
        "exitCode": 10,
        "message": "The OpenProse service returned an invalid response.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "expectFiles": [
    {
      "path": "x.md",
      "absent": true
    }
  ]
}
