    "exchanges": [
      {
        "method": "GET",
        "path": "/health",
        "status": 200,
        "body": {
          "status": "ok",
          "models": [
            "model-luna"
          ],
          "default_model": "model-luna"
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "json": {
      "interaction": "health.read",
      "operation": "service.status",
      "problem": null,
      "result": {
        "default_model": "model-luna",
        "environments": [],
        "models": [
          "model-luna"
        ],
        "status": "ok"
      },
      "schema": "openprose.service-operation/1"
    }
  }
