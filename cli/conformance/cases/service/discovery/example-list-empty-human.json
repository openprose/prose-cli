{
  "id": "example-list-empty-human",
  "feature": "discovery",
  "operation": "example.list",
  "description": "Human mode says so when there are no examples.",
  "argv": [
    "cli",
    "example",
    "list"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/examples/private",
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef",
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "Accept": "application/json"
        },
        "status": 200,
        "body": {
          "examples": []
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "text": "No examples.\n"
  },
  "stderr": {
    "text": ""
  }
}
