{
  "id": "wallet-usage-lone-start-today",
  "feature": "wallet",
  "operation": "wallet.usage",
  "description": "A lone --start equal to today (fixture clock) is sent as-is; the server defaults end to today.",
  "argv": [
    "--output",
    "json",
    "cli",
    "wallet",
    "usage",
    "--start",
    "2026-09-23"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/wallet/usage",
        "query": {
          "start": "2026-09-23"
        },
        "requestHeaders": {
          "Authorization": {
            "present": true
          }
        },
        "status": 200,
        "body": {
          "period": {
            "start": "2026-09-23",
            "end": "2026-09-23"
          },
          "total_runs": 0,
          "total_input_tokens": 0,
          "total_output_tokens": 0,
          "total_price_cents": 0,
          "daily": []
        }
      }
    ],
    "clock": {
      "start": "2026-09-23T12:00:00.000Z",
      "stepMs": 0
    }
  },
  "exitCode": 0,
  "stdout": {
    "json": {
      "interaction": "wallet.usage",
      "operation": "wallet.usage",
      "problem": null,
      "result": {
        "daily": [],
        "period": {
          "end": "2026-09-23",
          "start": "2026-09-23"
        },
        "total_input_tokens": 0,
        "total_output_tokens": 0,
        "total_price_cents": 0,
        "total_runs": 0
      },
      "schema": "openprose.service-operation/1"
    }
  }
}
