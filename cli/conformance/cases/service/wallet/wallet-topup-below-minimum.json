          "idempotencyKey": "6f1c2b3a-4d5e-4f60-8a7b-9c0d1e2f3a4b",
          "serviceMessage": "wallet credit must be at least 500 cents",
          "serviceStatus": 400
        },
        "exitCode": 10,
        "message": "The OpenProse service rejected the request.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
