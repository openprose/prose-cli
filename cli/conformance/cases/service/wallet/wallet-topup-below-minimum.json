{
  "id": "wallet-topup-below-minimum",
  "feature": "wallet",
  "operation": "wallet.topup",
  "description": "The service minimum (400 without a code) is SERVICE_REQUEST_REJECTED with serviceMessage; the CLI never checks prices itself.",
  "argv": [
    "--output",
    "json",
    "cli",
    "wallet",
    "topup",
    "--amount-cents",
    "100",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/wallet/topup",
        "requestHeaders": {
          "Authorization": {
            "present": true
          },
          "Idempotency-Key": "6f1c2b3a-4d5e-4f60-8a7b-9c0d1e2f3a4b",
          "Content-Type": "application/json"
        },
        "expectedBody": {
          "amount_cents": 100
        },
        "status": 400,
        "body": {
          "error": "wallet credit must be at least 500 cents"
        }
      }
    ],
    "ids": [
      "6f1c2b3a-4d5e-4f60-8a7b-9c0d1e2f3a4b"
    ]
  },
  "exitCode": 10,
  "stdout": {
