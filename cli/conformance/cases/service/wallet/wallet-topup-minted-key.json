{
  "id": "wallet-topup-minted-key",
  "feature": "wallet",
  "operation": "wallet.topup",
  "description": "Without --idempotency-key a UUIDv4 is minted, sent as Idempotency-Key and echoed as idempotencyKey; the body is exactly {amount_cents}.",
  "argv": [
    "--output",
    "json",
    "cli",
    "wallet",
    "topup",
    "--amount-cents",
    "500",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/wallet/topup",
        "requestHeaders": {
          "Authorization": {
            "present": true
          },
          "Idempotency-Key": "6f1c2b3a-4d5e-4f60-8a7b-9c0d1e2f3a4b",
          "Content-Type": "application/json"
        },
        "expectedBody": {
          "amount_cents": 500
        },
        "status": 200,
        "body": {
          "checkout_url": "https://checkout.stripe.com/c/pay/cs_test_a1b2c3#fid=x",
          "session_id": "cs_test_a1b2c3",
          "amount": {
            "credits_cents": 500,
            "fee_cents": 60,
            "total_cents": 560
          }
        }
      }
    ],
    "ids": [
      "6f1c2b3a-4d5e-4f60-8a7b-9c0d1e2f3a4b"
    ]
  },
  "exitCode": 0,
  "stdout": {
    "json": {
      "interaction": "wallet.topup",
      "operation": "wallet.topup",
      "problem": null,
      "result": {
        "amount": {
          "credits_cents": 500,
          "fee_cents": 60,
          "total_cents": 560
        },
        "checkout_url": "https://checkout.stripe.com/c/pay/cs_test_a1b2c3#fid=x",
        "idempotencyKey": "6f1c2b3a-4d5e-4f60-8a7b-9c0d1e2f3a4b",
        "session_id": "cs_test_a1b2c3"
      },
      "schema": "openprose.service-operation/1"
    }
  }
}
