{
  "id": "wallet-topup-amount-capped",
  "feature": "wallet",
  "operation": "wallet.topup",
  "description": "amount_capped is not an allowlisted service code: the 400 is SERVICE_REQUEST_REJECTED with serviceMessage and no serviceCode.",
  "argv": [
    "--output",
    "json",
    "cli",
    "wallet",
    "topup",
    "--amount-cents",
    "500000",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "POST",
        "path": "/wallet/topup",
        "requestHeaders": {
          "Authorization": {
            "present": true
          },
          "Idempotency-Key": "6f1c2b3a-4d5e-4f60-8a7b-9c0d1e2f3a4b",
          "Content-Type": "application/json"
        },
        "expectedBody": {
          "amount_cents": 500000
        },
        "status": 400,
        "body": {
          "error": "Refused: amount above the cap",
          "code": "amount_capped"
        }
      }
    ],
    "ids": [
      "6f1c2b3a-4d5e-4f60-8a7b-9c0d1e2f3a4b"
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "wallet.topup",
      "operation": "wallet.topup",
      "problem": {
        "action": "Correct the request as details.serviceMessage describes, then retry.",
        "boundary": "hosted-service",
        "code": "SERVICE_REQUEST_REJECTED",
        "details": {
          "idempotencyKey": "6f1c2b3a-4d5e-4f60-8a7b-9c0d1e2f3a4b",
          "serviceMessage": "Refused: amount above the cap",
          "serviceStatus": 400
        },
        "exitCode": 10,
        "message": "The OpenProse service rejected the request.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
