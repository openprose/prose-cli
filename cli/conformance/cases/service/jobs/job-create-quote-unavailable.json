{
  "id": "job-create-quote-unavailable",
  "feature": "jobs",
  "operation": "job.create",
  "description": "A failing quote (the service's 1101 crash) is SERVICE_UNAVAILABLE and the job is not created.",
  "argv": [
    "--output",
    "json",
    "cli",
    "job",
    "create",
    "--spec-file",
    "spec.json"
  ],
  "files": [
    {
      "path": "spec.json",
      "content": "{\"type\": \"schedule\", \"program_ref\": \"exowner1/jobs-example@0123456789abcdef\", \"interval_seconds\": 86400}\n"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/run/quote",
        "status": 500,
        "body": {
          "error_code": 1101
        },
        "requestHeaders": {
          "Authorization": {
            "present": false
          }
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "job.deploy",
      "operation": "job.create",
      "problem": {
        "action": "Check your network connection and retry later.",
        "boundary": "hosted-service",
        "code": "SERVICE_UNAVAILABLE",
        "details": {
          "serviceStatus": 500
        },
        "exitCode": 10,
        "message": "The OpenProse service is unavailable.",
        "retryable": true,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
