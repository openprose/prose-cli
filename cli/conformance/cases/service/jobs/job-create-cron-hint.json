{
  "id": "job-create-cron-hint",
  "feature": "jobs",
  "operation": "job.create",
  "description": "A `cron` key in a schedule spec is refused with the interval_seconds hint (3600 = hourly).",
  "argv": [
    "--output",
    "json",
    "cli",
    "job",
    "create",
    "--spec-file",
    "spec.json",
    "--preview"
