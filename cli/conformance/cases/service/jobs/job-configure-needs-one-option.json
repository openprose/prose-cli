{
  "id": "job-configure-needs-one-option",
  "feature": "jobs",
  "operation": "job.configure",
  "description": "`job configure` without --config-file or --interval-seconds is INVOCATION_INVALID before any request.",
  "argv": [
    "--output",
    "json",
    "cli",
    "job",
    "configure",
    "7b2e4d19-6a3c-4e85-b1f0-9c4d8e2a6b73",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": []
  },
  "exitCode": 2,
  "stdout": {
    "json": {
      "interaction": "job.update",
      "operation": "job.configure",
      "problem": {
        "action": "Correct the value named in Detail; `prose --output json cli job configure --help` shows the accepted syntax.",
        "boundary": "invocation",
        "code": "INVOCATION_INVALID",
