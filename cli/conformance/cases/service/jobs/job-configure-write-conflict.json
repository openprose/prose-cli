{
  "id": "job-configure-write-conflict",
  "feature": "jobs",
  "operation": "job.configure",
  "description": "A stale configuration token (409) is SERVICE_WRITE_CONFLICT with the service message.",
  "argv": [
    "--output",
    "json",
    "cli",
    "job",
    "configure",
    "7b2e4d19-6a3c-4e85-b1f0-9c4d8e2a6b73",
    "--config-file",
    "config.json",
    "--yes"
  ],
  "files": [
    {
      "path": "config.json",
      "content": "{\"interval_seconds\": 3600, \"configuration_revision\": 3, \"revision_token\": \"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\", \"bindings\": [{\"program_ref\": \"exowner1/jobs-example@0123456789abcdef\", \"run_configuration\": {\"model\": \"model-luna\"}}]}"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "PUT",
        "path": "/triggers/7b2e4d19-6a3c-4e85-b1f0-9c4d8e2a6b73/configuration",
        "status": 409,
        "body": {
          "error": "This job changed; reload it and try again."
        },
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "job.update",
      "operation": "job.configure",
      "problem": {
        "action": "Read the current state of the resource, reconcile the change, then retry.",
        "boundary": "hosted-service",
        "code": "SERVICE_WRITE_CONFLICT",
        "details": {
          "serviceMessage": "This job changed; reload it and try again.",
          "serviceStatus": 409
        },
        "exitCode": 10,
        "message": "The OpenProse service reported a conflicting write.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
