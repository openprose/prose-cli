{
  "id": "job-list-missing-id-protocol-invalid",
  "feature": "jobs",
  "operation": "job.list",
  "description": "A job without an id is SERVICE_PROTOCOL_INVALID naming the field.",
  "argv": [
    "--output",
    "json",
    "cli",
    "job",
    "list"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/triggers",
        "status": 200,
