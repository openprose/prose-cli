          "max_triggers": 5,
          "trigger_limit": {
            "kind": "unlimited"
          },
          "types": []
        },
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
