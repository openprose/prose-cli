{
  "id": "job-create-quote-program-not-found",
  "feature": "jobs",
  "operation": "job.create",
  "description": "A job's program the service cannot read is SERVICE_RESOURCE_NOT_FOUND from the plan's quote; no job is created.",
  "argv": [
    "--output",
    "json",
    "cli",
    "job",
    "create",
    "--spec-file",
    "spec.json",
    "--preview"
  ],
  "files": [
    {
      "path": "spec.json",
      "content": "{\"type\": \"schedule\", \"program_ref\": \"exowner1/jobs-example@0123456789abcdef\", \"interval_seconds\": 86400}\n"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/run/quote",
        "query": {
          "program_ref": "exowner1/jobs-example@0123456789abcdef",
          "job_type": "schedule"
        },
        "requestHeaders": {
          "Authorization": {
            "present": true
          }
        },
        "status": 404,
        "body": {
          "error": "Program not found.",
          "code": "program_not_found"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "job.deploy",
      "operation": "job.create",
      "problem": {
        "action": "Check the identifier, then retry.",
        "boundary": "hosted-service",
        "code": "SERVICE_RESOURCE_NOT_FOUND",
        "details": {
          "serviceCode": "program_not_found",
          "serviceStatus": 404
        },
        "exitCode": 10,
        "message": "The requested OpenProse service resource was not found.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "stderr": {
    "text": ""
  }
}
