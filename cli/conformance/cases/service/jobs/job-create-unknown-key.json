{
  "id": "job-create-unknown-key",
  "feature": "jobs",
  "operation": "job.create",
  "description": "An unknown spec key is refused with the nearest accepted key; the misspelled required key is not reported twice.",
  "argv": [
    "--output",
    "json",
    "cli",
    "job",
    "create",
    "--spec-file",
    "spec.json",
    "--preview"
  ],
  "files": [
    {
      "path": "spec.json",
      "content": "{\"type\": \"schedule\", \"program_ref\": \"exowner1/jobs-example@0123456789abcdef\", \"intervalSecond\": 86400}"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": []
  },
  "exitCode": 2,
  "stdout": {
    "json": {
      "interaction": "job.deploy",
      "operation": "job.create",
      "problem": {
        "action": "Correct the value named in Detail; `prose --output json cli job create --help` shows the accepted syntax.",
        "boundary": "invocation",
        "code": "INVOCATION_INVALID",
        "details": {
          "reason": "unknown key intervalSecond; did you mean interval_seconds?",
          "suggestedArgv": [
            "--output",
            "json",
            "cli",
            "job",
            "create",
            "--help"
          ],
          "violations": [
            "unknown key intervalSecond; did you mean interval_seconds?"
          ]
        },
        "exitCode": 2,
        "message": "That command isn't quite right.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
