{
  "id": "result-list-without-any-credential",
  "feature": "results",
  "operation": "result.list",
  "description": "result list needs no API key and no credential store.",
  "argv": [
    "--output",
    "json",
    "cli",
    "result",
    "list",
    "Owner/demo"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": null
    },
    "storeAvailable": false,
    "exchanges": [
      {
        "method": "GET",
        "path": "/p/Owner/demo/results",
        "status": 200,
        "query": {
          "limit": "20"
        },
        "body": {
          "contract": {
            "owner": "Owner",
            "slug": "demo",
            "rev_id": "0123456789abcdef"
          },
          "results": []
        },
        "requestHeaders": {
          "Authorization": {
            "present": false
          },
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          }
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "json": {
      "schema": "openprose.service-operation/1",
      "operation": "result.list",
      "interaction": "results.list_public",
      "result": {
        "contract": {
          "owner": "Owner",
          "slug": "demo",
          "rev_id": "0123456789abcdef"
        },
        "results": []
      },
      "problem": null
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
