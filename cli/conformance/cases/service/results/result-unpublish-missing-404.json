  "description": "An unknown (or already removed) publication is SERVICE_RESOURCE_NOT_FOUND.",
  "argv": [
    "--output",
    "json",
    "cli",
    "result",
    "unpublish",
    "demo",
    "AbCdEf012_-x",
    "--yes"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
