{
  "id": "result-list-bad-program",
  "feature": "results",
  "operation": "result.list",
  "description": "A value that is neither OWNER/SLUG nor a bare lowercase SLUG is INVOCATION_INVALID before any request.",
  "argv": [
    "--output",
    "json",
    "cli",
    "result",
    "list",
    "Demo"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": []
  },
  "exitCode": 2,
  "stdout": {
    "json": {
      "interaction": "results.list_public",
      "operation": "result.list",
      "problem": {
        "action": "Correct the value named in Detail; `prose --output json cli result list --help` shows the accepted syntax.",
        "boundary": "invocation",
        "code": "INVOCATION_INVALID",
        "details": {
          "reason": "program \"Demo\" must be OWNER/SLUG (an owner handle and a lowercase program slug) or a bare SLUG for your own program; `cli result` reads published results, and a run's own output is `cli run show RUN_ID`",
          "suggestedArgv": [
            "--output",
            "json",
            "cli",
            "result",
            "list",
            "--help"
          ]
        },
        "exitCode": 2,
        "message": "That command isn't quite right.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "rr_test_0123456789abcdef0123456789abcdef"
  ]
}
