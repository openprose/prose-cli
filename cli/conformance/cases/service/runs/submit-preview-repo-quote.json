{
  "id": "submit-preview-repo-quote",
  "feature": "runs",
  "operation": "run.submit",
  "description": "A --repo makes the plan's quote send repositories=1 with the environment: a bound repository adds to the hold. The repository itself is not sent to the quote.",
  "argv": [
    "--output",
    "json",
    "cli",
    "run",
    "submit",
    "p.prose.md",
    "--environment",
