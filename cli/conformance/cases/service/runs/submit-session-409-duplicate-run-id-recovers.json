{
  "id": "submit-session-409-duplicate-run-id-recovers",
  "feature": "runs",
  "operation": "run.submit",
  "description": "With --session, a duplicate-session 409 that names the run (run_id body field, as the service sends) is that run: exit 0 with reused: true.",
  "argv": [
    "--output",
    "json",
    "cli",
    "run",
    "submit",
    "p.prose.md",
    "--yes",
    "--detach",
    "--session",
    "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
  ],
  "files": [
    {
      "path": "p.prose.md",
      "content": "---\nname: hello\nkind: function\n---\n\nReply with the word ok.\n"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "clock": {
      "start": "2026-09-24T01:00:00.000Z",
      "stepMs": 0
    },
    "exchanges": [
      {
        "method": "POST",
        "path": "/run",
        "query": {
          "live": "1",
          "session": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d"
        },
        "requestHeaders": {
          "X-Session-Id": "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
          "Accept": "text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "expectedBody": {
          "content": "---\nname: hello\nkind: function\n---\n\nReply with the word ok.\n"
        },
        "status": 409,
        "responseHeaders": {
          "X-Run-Id": "run_4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c"
        },
        "body": {
          "error": "This session already has a run. Reconnect instead of submitting it again.",
          "run_id": "run_4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c"
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "json": {
      "interaction": "run.submit",
      "operation": "run.submit",
      "problem": null,
      "result": {
        "afterSequence": 0,
        "cancelArgv": [
          "--output",
          "json",
          "cli",
          "run",
          "cancel",
          "run_4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c",
          "--session",
          "0a1b2c3d-4e5f-4a6b-8c7d-9e0f1a2b3c4d",
          "--yes"
        ],
        "detached": true,
        "resumeArgv": [
          "--output",
          "json",
          "cli",
          "run",
          "watch",
          "run_4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c",
          "--after",
          "0",
