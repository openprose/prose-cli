{
  "id": "quote-accepts-submit-arguments",
  "feature": "runs",
  "operation": "run.quote",
  "description": "With FILE, `run quote` posts the program and the hold options to the quote, as `run submit` would send them; inputs are not sent. Human output names each basis value and its source.",
  "argv": [
    "cli",
    "run",
    "quote",
    "hello.prose.md",
    "--input",
    "topic=cats",
    "--model",
    "model-sol"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/health",
        "status": 200,
        "body": {
          "status": "ok",
          "environments": {
            "default": "builtin",
            "available": [
              "builtin",
              "linux"
            ]
          },
          "models": [
            "model-luna",
            "model-sol"
          ],
          "default_model": "model-luna",
          "version": "9.9.9-extra",
          "capabilities": {
            "web:search": {
              "available": true,
              "tool": "web_search"
            }
          }
        }
      },
      {
        "method": "POST",
        "path": "/run/quote",
        "requestHeaders": {
          "Authorization": {
            "present": true
          }
        },
        "expectedBody": {
          "content": "---\nname: hello\nkind: function\n---\n\nReply with the word ok.\n",
          "model": "model-sol"
        },
        "status": 200,
        "body": {
          "hold": {
            "hold_usd": "1.02",
            "ttl_seconds": 900
          },
          "pricing_policy_id": "pricing-policy.sha256.f114eadc02b7550e58f12c49996382b04f867cb774ac295506806f599ef1e3cd",
          "note": "Unused hold is released when the run settles.",
          "basis": {
            "model": {
              "value": "model-sol",
              "source": "request"
            },
            "reasoning_effort": {
              "value": "medium",
              "source": "program"
            },
            "environment": {
              "value": "builtin",
              "source": "default"
            },
            "tools": {
              "value": [
                "web:search"
              ],
              "source": "program"
            },
            "repositories": {
              "value": 0,
              "source": "default"
            }
          }
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "text": "Environment: builtin\nHold: $1.02, set aside from the wallet while a run is live; not its price. Released within 900 s when unused\nDepends on: model, reasoning effort, environment, declared tools and repositories; quoted for the program and options given\nBasis: model model-sol (request); reasoning effort medium (program); environment builtin (default); tools web:search (program); repositories 0 (default)\nPrice: known only after a run settles; read it with `prose cli run show RUN_ID`\nNote: Unused hold is released when the run settles.\n"
  },
  "stderr": {
    "text": ""
  },
  "forbid": [
    "9.9.9-extra",
    "web_search"
  ],
  "files": [
    {
      "path": "hello.prose.md",
      "content": "---\nname: hello\nkind: function\n---\n\nReply with the word ok.\n"
    }
  ]
}
