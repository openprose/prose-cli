{
  "id": "submit-feature-disabled",
  "feature": "runs",
  "operation": "run.submit",
  "description": "A feature_disabled answer to a live submit is SERVICE_FEATURE_DISABLED; the CLI never falls back to a non-live run and never echoes the feature name.",
  "argv": [
    "--output",
    "json",
    "cli",
    "run",
    "submit",
    "p.prose.md",
    "--yes"
  ],
  "files": [
    {
      "path": "p.prose.md",
      "content": "---\nname: hello\nkind: function\n---\n\nReply with the word ok.\n"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "ids": [
      "5f0c8a1e-3b2d-4c6e-9f70-1a2b3c4d5e6f"
    ],
    "clock": {
      "start": "2026-09-24T01:00:00.000Z",
      "stepMs": 0
    },
    "exchanges": [
      {
        "method": "POST",
        "path": "/run",
        "query": {
          "live": "1",
          "session": "5f0c8a1e-3b2d-4c6e-9f70-1a2b3c4d5e6f"
        },
        "requestHeaders": {
          "X-Session-Id": "5f0c8a1e-3b2d-4c6e-9f70-1a2b3c4d5e6f",
          "Accept": "text/event-stream",
          "Content-Type": "application/json",
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "expectedBody": {
          "content": "---\nname: hello\nkind: function\n---\n\nReply with the word ok.\n"
        },
        "status": 403,
        "body": {
          "error": "Live runs are disabled.",
          "code": "feature_disabled",
          "feature": "example_feature"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "run.submit",
      "operation": "run.submit",
      "problem": {
        "action": "Check your plan or organization, or contact OpenProse support.",
        "boundary": "hosted-service",
        "code": "SERVICE_FEATURE_DISABLED",
        "details": {
          "serviceCode": "feature_disabled",
          "serviceStatus": 403
        },
        "exitCode": 10,
        "message": "This capability is not available for this account.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  },
  "forbid": [
    "example_feature",
    "Live runs are disabled."
  ]
}
