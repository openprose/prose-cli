{
  "id": "watch-no-journal-live",
  "feature": "runs",
  "operation": "run.watch",
  "description": "Without --session or a journal entry, a run with no record (404) is SERVICE_RESOURCE_NOT_FOUND (10) naming the run: it does not exist, or it has not ended and was submitted from another machine; details.suggestedArgv lists recent runs.",
  "argv": [
    "--output",
    "json",
    "cli",
    "run",
    "watch",
    "run_4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/runs/run_4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c",
        "requestHeaders": {
          "Authorization": {
            "pattern": "^Bearer rr_test_[0-9a-f]{32}$"
          }
        },
        "status": 404,
        "body": {
          "error": "Run not found"
        }
      }
    ]
  },
  "exitCode": 10,
  "stdout": {
    "json": {
      "interaction": "run.observe",
      "operation": "run.watch",
      "problem": {
        "action": "Run `prose --output json cli run list --limit 5` to find the right run, then retry with it.",
        "boundary": "hosted-service",
        "code": "SERVICE_RESOURCE_NOT_FOUND",
        "details": {
          "reason": "run run_4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c was not found: no run has this id, or it has not ended and was submitted from another machine (a run's record is written when it ends)",
          "resource": {
            "id": "run_4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c",
            "kind": "run"
          },
          "runId": "run_4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c4f1c2d3e4f5a6b7c",
          "serviceStatus": 404,
          "suggestedArgv": [
            "--output",
            "json",
            "cli",
            "run",
            "list",
            "--limit",
            "5"
          ]
        },
        "exitCode": 10,
        "message": "The requested OpenProse service resource was not found.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
