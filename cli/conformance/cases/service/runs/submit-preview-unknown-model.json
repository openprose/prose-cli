{
  "id": "submit-preview-unknown-model",
  "feature": "runs",
  "operation": "run.submit",
  "description": "An unknown --model fails before confirmation with the nearest offered models and a corrected argv.",
  "argv": [
    "--output",
    "json",
    "cli",
    "run",
    "submit",
    "p.prose.md",
    "--model",
    "model-lnua",
    "--preview"
  ],
  "files": [
    {
      "path": "p.prose.md",
      "content": "---\nname: demo\nkind: program\n---\nSay hi.\n"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/models",
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef",
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "Accept": "application/json"
        },
        "status": 200,
        "body": {
          "models": [
            "model-astra",
            "model-sol",
            "model-luna"
          ],
          "default_model": "model-sol"
        }
      }
    ]
  },
  "exitCode": 2,
  "stdout": {
    "json": {
      "interaction": "run.submit",
      "operation": "run.submit",
      "problem": {
        "action": "Rerun with a model the service offers, for example `prose --output json cli run submit p.prose.md --model model-luna --preview`.",
        "boundary": "invocation",
        "code": "INVOCATION_INVALID",
        "details": {
          "reason": "--model \"model-lnua\" is not a model this account may run; nearest: model-luna, model-astra, model-sol; `prose --output json cli model list` lists them all",
          "suggestedArgv": [
            "--output",
            "json",
            "cli",
            "run",
            "submit",
            "p.prose.md",
            "--model",
            "model-luna",
            "--preview"
          ]
        },
        "exitCode": 2,
        "message": "That command isn't quite right.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
