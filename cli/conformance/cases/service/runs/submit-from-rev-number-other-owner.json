        "details": {
          "reason": "revision numbers such as @2 resolve only for your own programs; for alice/hello pass the 16-hex-digit rev_id, which `prose --output json cli program show alice/hello` prints (latest) as `ref`",
          "suggestedArgv": [
            "--output",
            "json",
            "cli",
            "program",
            "show",
