{
  "id": "submit-from-rev-number-other-owner",
  "feature": "runs",
  "operation": "run.submit",
  "description": "`@N` of another owner's program cannot be resolved (only your own revisions are listed): the reason names the rev_id to pass.",
  "argv": [
    "--output",
    "json",
    "cli",
    "run",
    "submit",
    "--from",
    "alice/hello@2",
    "--preview"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "clock": {
      "start": "2026-09-24T01:00:00.000Z",
      "stepMs": 0
    },
    "exchanges": [
      {
        "method": "GET",
        "path": "/programs/hello/revisions",
        "status": 200,
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef"
        },
        "body": {
          "revisions": [
            {
              "owner": "octo",
              "slug": "hello",
              "rev": 2,
              "rev_id": "0123456789abcdef",
              "commit_id": "1111111111111111",
              "parent_commit_id": "2222222222222222",
              "updated_at": 1790212199320
            },
            {
              "owner": "octo",
              "slug": "hello",
              "rev": 1,
              "rev_id": "fedcba9876543210",
              "commit_id": "2222222222222222",
              "parent_commit_id": null,
              "updated_at": 1790212000000
            }
          ]
        }
      }
    ]
  },
  "exitCode": 2,
  "stdout": {
    "json": {
      "interaction": "run.submit",
      "operation": "run.submit",
      "problem": {
