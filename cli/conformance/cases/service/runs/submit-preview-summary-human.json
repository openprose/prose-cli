{
  "id": "submit-preview-summary-human",
  "feature": "runs",
  "operation": "run.submit",
  "description": "The human preview prints plannedRequest.summary (model, input keys; never input values) and the flat hold.",
  "argv": [
    "cli",
    "run",
    "submit",
    "p.prose.md",
    "--model",
    "model-luna",
    "--input",
    "topic=cats",
    "--input",
    "audience=kids",
    "--preview"
  ],
  "files": [
    {
      "path": "p.prose.md",
      "content": "---\nname: demo\nkind: program\n---\nSay hi.\n"
    }
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": [
      {
        "method": "GET",
        "path": "/models",
        "requestHeaders": {
          "Authorization": "Bearer rr_test_0123456789abcdef0123456789abcdef",
          "X-OpenProse-Client": {
            "pattern": "^cli/[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?\\+(rust|bun)$"
          },
          "Accept": "application/json"
        },
        "status": 200,
        "body": {
          "models": [
            "model-astra",
            "model-sol",
            "model-luna"
          ],
          "default_model": "model-sol"
        }
      },
      {
        "method": "GET",
        "path": "/run/quote",
        "requestHeaders": {
          "Authorization": {
            "present": false
          }
        },
        "status": 200,
        "body": {
          "hold": {
            "hold_usd": "1.02",
            "ttl_seconds": 900
          },
          "pricing_policy_id": "pricing-policy.sha256.f114eadc02b7550e58f12c49996382b04f867cb774ac295506806f599ef1e3cd",
          "note": "Unused hold is released when the run settles."
        }
      }
    ]
  },
  "exitCode": 0,
  "stdout": {
    "text": "Preview: Run a program on the hosted service and stream it until it finishes, detaches or the deadline passes.\nSummary: model model-luna; inputs audience, topic\nEffect: starts a paid run\nHold: $1.02 (set aside from the wallet while the run is live; not its price)\nNothing was changed.\n"
  },
  "stderr": {
    "text": ""
  }
}
