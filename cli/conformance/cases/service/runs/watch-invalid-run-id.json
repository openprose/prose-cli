{
  "id": "watch-invalid-run-id",
  "feature": "runs",
  "operation": "run.watch",
  "description": "A malformed run id is rejected before any request.",
  "argv": [
    "--output",
    "json",
    "cli",
    "run",
    "watch",
    "not-a-run"
  ],
  "fixture": {
    "environment": "production",
    "credentials": {
      "production": "rr_test_0123456789abcdef0123456789abcdef"
    },
    "storeAvailable": true,
    "exchanges": []
  },
  "exitCode": 2,
  "stdout": {
    "json": {
      "interaction": "run.observe",
      "operation": "run.watch",
      "problem": {
        "action": "Correct the value named in Detail; `prose --output json cli run watch --help` shows the accepted syntax.",
        "boundary": "invocation",
        "code": "INVOCATION_INVALID",
        "details": {
          "reason": "run id \"not-a-run\" is invalid; a run id is run_ followed by lowercase hex digits; list runs with `prose --output json cli run list`",
          "suggestedArgv": [
            "--output",
            "json",
            "cli",
            "run",
            "watch",
            "--help"
          ]
        },
        "exitCode": 2,
        "message": "That command isn't quite right.",
        "retryable": false,
        "schema": "openprose.runner-error/1"
      },
      "result": null,
      "schema": "openprose.service-operation/1"
    }
  }
}
