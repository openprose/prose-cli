{
  "schema": "openprose.runner-case/1",
  "id": "core.openprose-invalid-transport-run",
  "summary": "A language run rejects an explicit unsupported hosted transport before reporting hosted-service availability.",
  "phase": 6,
  "tags": [
    "default",
    "agent-dx",
    "differential",
    "fail-closed",
    "machine-output",
    "transport"
  ],
  "controls": {
    "fixedInvocationId": "fixture-invocation-0001",
    "fixedTimestamp": "2025-01-01T00:00:00Z",
    "fixedMonotonicMs": 0,
    "network": "denied"
  },
  "invocation": {
    "argv": [
      "--harness",
      "openprose",
      "--transport",
      "unsupported",
      "--output",
      "json",
      "run",
      "fixture.prose.md"
    ],
    "cwd": "{{WORKSPACE}}",
    "environment": {}
  },
  "expected": {
    "exitCode": 20,
    "stdout": {
      "kind": "json",
      "schema": "openprose.runner-error/1"
    },
    "stderr": {
      "kind": "empty"
    },
    "startedHarness": false,
    "resultMatches": {
      "code": "TRANSPORT_UNSUPPORTED",
      "boundary": "adapter",
      "message": "The selected harness does not support the requested transport.",
      "action": "Choose a transport listed for this harness by the `cli harness list` runner operation.",
      "exitCode": 20,
      "retryable": false,
      "details": {
        "harness": "openprose",
        "requested": "unsupported",
        "supported": [
          "hosted"
        ]
      }
    }
  }
}
