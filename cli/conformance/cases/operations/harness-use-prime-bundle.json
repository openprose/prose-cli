{
  "schema": "openprose.runner-case/1",
  "id": "operations.harness-use-prime-bundle",
  "summary": "Both products atomically persist an explicit Prime harness, model, and auth-profile bundle without starting it.",
  "phase": 6,
  "tags": ["cli", "configuration", "agent-dx", "differential", "saved-selection"],
  "controls": {
    "fixedInvocationId": "fixture-invocation-0001",
    "fixedTimestamp": "2025-01-01T00:00:00Z",
    "fixedMonotonicMs": 0,
    "network": "denied"
  },
  "invocation": {
    "argv": [
      "--output",
      "json",
      "cli",
      "harness",
      "use",
      "prime",
      "--model",
      "fixture/model",
      "--auth-profile",
      "prime-harness-login"
    ],
    "cwd": "{{WORKSPACE}}",
    "environment": {
      "HOME": "{{WORKSPACE}}/home",
      "XDG_CONFIG_HOME": "{{WORKSPACE}}/config"
    }
  },
  "expected": {
    "exitCode": 0,
    "stdout": { "kind": "json", "schema": "openprose.harness-selection/1" },
    "stderr": { "kind": "empty" },
    "startedHarness": false,
    "resultMatches": {
      "schema": "openprose.harness-selection/1",
      "harness": "prime",
      "scope": "user",
      "path": "{{WORKSPACE}}/home/.prose/cli.toml",
      "changed": true
    },
    "fileEffects": [
      {
        "path": "{{WORKSPACE}}/home/.prose/cli.toml",
        "utf8": "auth_profile = \"prime-harness-login\"\nharness = \"prime\"\nmodel = \"fixture/model\"\n"
      }
    ]
  }
}
