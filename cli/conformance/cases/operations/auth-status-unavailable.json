{
  "schema": "openprose.runner-case/1",
  "id": "operations.auth-status-unavailable",
  "summary": "Production account status refuses a malformed explicit credential as SERVICE_AUTH_REQUIRED naming OPENPROSE_API_KEY, without network or native store access.",
  "phase": 6,
  "tags": [
    "cli",
    "auth",
    "agent-dx",
    "differential",
    "no-secret"
  ],
  "controls": {
    "fixedInvocationId": "fixture-invocation-0001",
    "fixedTimestamp": "2025-01-01T00:00:00Z",
    "fixedMonotonicMs": 0,
    "network": "denied"
  },
  "invocation": {
    "argv": [
      "--output",
      "json",
      "cli",
      "auth",
      "status"
    ],
    "cwd": "{{WORKSPACE}}",
    "environment": {
      "HOME": "{{WORKSPACE}}/home",
      "XDG_CONFIG_HOME": "{{WORKSPACE}}/config",
      "OPENPROSE_API_KEY": "invalid-fixture-credential"
    }
  },
  "expected": {
    "exitCode": 10,
    "stdout": {
      "kind": "json",
      "schema": "openprose.service-operation/1"
    },
    "stderr": {
      "kind": "empty"
    },
    "startedHarness": false,
    "resultMatches": {
      "schema": "openprose.service-operation/1",
      "operation": "auth.status",
      "interaction": "cli.auth_status",
      "result": null,
      "problem": {
        "code": "SERVICE_AUTH_REQUIRED",
        "action": "Replace or unset OPENPROSE_API_KEY, then retry.",
        "details": {
          "credentialProblem": "malformed",
          "credentialSource": "environment",
          "credentialVariable": "OPENPROSE_API_KEY"
        }
      }
    }
  }
}
