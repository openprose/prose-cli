{
  "schema": "openprose.runner-case/1",
  "id": "adapters.sdk-production-01",
  "summary": "Pure exact explanation resolves shipped SDK defaults without probing a helper or credential.",
  "phase": 7,
  "tags": [
    "adapter",
    "agents-sdk",
    "production",
    "provider-free",
    "differential"
  ],
  "platforms": [
    "unix"
  ],
  "controls": {
    "fixedInvocationId": "fixture-invocation-0001",
    "fixedTimestamp": "2025-01-01T00:00:00Z",
    "fixedMonotonicMs": 0,
    "network": "denied",
    "installedAdapter": {
      "adapterId": "agents-sdk/jsonl",
      "sdkScenario": "trap",
      "sdkInstallation": "sibling"
    }
  },
  "invocation": {
    "argv": [
      "cli",
      "config",
      "explain",
      "--json",
      "--",
      "run",
      "input.prose.md"
    ],
    "cwd": "{{WORKSPACE}}",
    "environment": {
      "HOME": "{{WORKSPACE}}/home",
      "XDG_CONFIG_HOME": "{{WORKSPACE}}/config"
    }
  },
  "expected": {
    "exitCode": 0,
    "stdout": {
      "kind": "json",
      "schema": "openprose.configuration-explanation/1"
    },
    "stderr": {
      "kind": "empty"
    },
    "startedHarness": false,
    "resultMatches": {
      "target": {
        "argv": [
          "prose",
          "run",
          "input.prose.md"
        ]
      },
      "values": {
        "harness": {
          "value": "agents-sdk",
          "source": {
            "kind": "default",
            "location": "built-in"
          }
        },
        "model": {
          "value": "gpt-6.1-sol",
          "source": {
            "kind": "default",
            "location": "built-in:agents-sdk"
          }
        },
        "authProfile": {
          "value": "openai-api-key",
          "source": {
            "kind": "default",
            "location": "built-in:agents-sdk"
          }
        }
      },
      "runtime": {
        "transport": "jsonl",
        "authProfile": "openai-api-key",
        "billingOwner": "user-provider",
        "permissionMode": null,
        "nativeLimits": {
          "maxTurns": 20,
          "timeoutSeconds": 180,
          "toolTimeoutSeconds": 30,
          "maxOutputTokens": 12000,
          "maxAggregateRequests": 20,
          "maxAggregateHostedWebCalls": 20,
          "maxAggregateFunctionTools": 80,
          "maxObservedTotalTokens": 500000,
          "maxRequestInputBytes": 256000,
          "maxChildren": 8,
          "maxChildDepth": 1
        }
      }
    }
  }
}
